//@version=5
strategy("TradingBrain v14 - M5/M1 Structure Draft", overlay=true, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.02, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true)

// STRUCTURAL STUDY ONLY. NOT fitted to the journal; no performance claims.
// User-described Parts 1/2/3; exact visual pivots, session times and the
// bearish previous-higher-low identification remain provisional. Not verified
// VLB/VHB. No alerts, relay or MT5 execution.
// Use standard M1 candles only. Do not use Heikin Ashi or other synthetic charts.
// process_orders_on_close simulates a market fill at the signal-bar close in
// TradingView's broker emulator; actual execution is not guaranteed at close.
Enable_Simulation = input.bool(false, "Enable structural simulation (OFF by default)")
Sessions_Confirmed = input.bool(false, "I confirmed session times and timezones")
NQ_Session = input.session("0930-1600", "New York session (proposed)")
NQ_Timezone = input.string("America/New_York", "New York timezone (proposed IANA)")
Asian_Session = input.session("0100-0600", "Asian session (proposed)")
Asian_Timezone = input.string("Etc/UTC", "Asian timezone (proposed IANA)")
M5_Lookback = input.int(50, "Maximum M5 pivot age (bars; provisional)", minval=2, maxval=1000)
M5_Left = input.int(2, "M5 pivot left bars (provisional)", minval=1, maxval=50)
M5_Right = input.int(2, "M5 pivot right bars (provisional)", minval=1, maxval=50)
M1_Left = input.int(2, "M1 pivot left bars (provisional)", minval=1, maxval=50)
M1_Right = input.int(2, "M1 pivot right bars (provisional)", minval=1, maxval=50)
RR_Ratio = input.float(2.5, "Simulated reward/risk (e.g. 2, 5, 7)", minval=0.1, maxval=100, step=0.1)
Stop_Buffer_Ticks = input.int(10, "Engulfing-candle stop buffer (ticks)", minval=0, maxval=1000)
Order_Quantity = input.float(1.0, "Simulated quantity", minval=0.000001)
Engulf_Multiplier = input.float(1.2, "Engulf body size multiplier", minval=1.0, maxval=10.0, step=0.1)
Fib_Tolerance_Ticks = input.int(10, "0.382 entry proximity (ticks)", minval=0, maxval=1000)

isM1 = timeframe.isminutes and timeframe.multiplier == 1
isStandard = chart.is_standard
// Sessions use the M1 bar OPEN and TradingView's default session weekdays.
// Both proposed session times and IANA timezones must be confirmed first.
isNQ = isM1 and not na(time(timeframe.period, NQ_Session, NQ_Timezone))
isAsian = isM1 and not na(time(timeframe.period, Asian_Session, Asian_Timezone))
isGoldenSession = Enable_Simulation and Sessions_Confirmed and isM1 and isStandard and (isNQ or isAsian)

// PART 1 + PART 3: M5 completed bars only. Bullish M5 uses normal candles;
// bearish M5 uses Heikin Ashi as described in Part 3. HA OHLC is synthetic,
// not an executable market price. On M1, the completed M5 event is processed
// at the close of the first M1 candle in the next M5 interval. Pivots require
// right-hand confirmation and a 50-bar max age is a provisional interpretation.
f_completedM5() =>
    ph = ta.pivothigh(high, M5_Left, M5_Right)
    pl = ta.pivotlow(low, M5_Left, M5_Right)
    swingHigh = ta.valuewhen(not na(ph), ph, 0)
    swingLow = ta.valuewhen(not na(pl), pl, 0)
    prevHigh = ta.valuewhen(not na(ph), ph, 1)
    prevLow = ta.valuewhen(not na(pl), pl, 1)
    highIndex = ta.valuewhen(not na(ph), bar_index - M5_Right, 0)
    lowIndex = ta.valuewhen(not na(pl), bar_index - M5_Right, 0)
    prevHighIndex = ta.valuewhen(not na(ph), bar_index - M5_Right, 1)
    prevLowIndex = ta.valuewhen(not na(pl), bar_index - M5_Right, 1)
    [time[1], bar_index[1], high[1], low[1], close[1], swingHigh[1], swingLow[1], prevHigh[1], prevLow[1], highIndex[1], lowIndex[1], prevHighIndex[1], prevLowIndex[1]]
[m5Time, m5Index, m5High, m5Low, m5Close, m5SwingHigh, m5SwingLow, m5PrevHigh, m5PrevLow, m5HighIndex, m5LowIndex, m5PrevHighIndex, m5PrevLowIndex] = request.security(syminfo.tickerid, "5", f_completedM5(), lookahead=barmerge.lookahead_on)
haTicker = ticker.heikinashi(syminfo.tickerid)
[haTime, haIndex, haHigh, haLow, haClose, haSwingHigh, haSwingLow, haPrevHigh, haPrevLow, haHighIndex, haLowIndex, haPrevHighIndex, haPrevLowIndex] = request.security(haTicker, "5", f_completedM5(), lookahead=barmerge.lookahead_on)
newM5 = isM1 and barstate.isconfirmed and not na(m5Time) and (na(m5Time[1]) or m5Time != m5Time[1])
newHaM5 = isM1 and barstate.isconfirmed and not na(haTime) and (na(haTime[1]) or haTime != haTime[1])
validHigh = not na(m5SwingHigh) and not na(m5HighIndex) and not na(m5Index) and m5Index - m5HighIndex <= M5_Lookback
validLow = not na(m5SwingLow) and not na(m5LowIndex) and not na(m5Index) and m5Index - m5LowIndex <= M5_Lookback
validHaLow = not na(haSwingLow) and not na(haLowIndex) and not na(haIndex) and haIndex - haLowIndex <= M5_Lookback
validHaHigh = not na(haSwingHigh) and not na(haHighIndex) and not na(haIndex) and haIndex - haHighIndex <= M5_Lookback
validHaPrevLow = not na(haPrevLow) and not na(haPrevLowIndex) and not na(haIndex) and haIndex - haPrevLowIndex <= M5_Lookback
validHaPrevHigh = not na(haPrevHigh) and not na(haPrevHighIndex) and not na(haIndex) and haIndex - haPrevHighIndex <= M5_Lookback
// Part 3: mechanical approximation of Low -> LL -> LH before a close below
// the LL. The prior pivot low is higher than the broken LL and is the proposed
// earlier higher-low anchor. Confirm these choices on the user's chart.
haBearStructure = validHaLow and validHaHigh and validHaPrevLow and validHaPrevHigh and haPrevLow > haSwingLow and haSwingHigh < haPrevHigh and haHighIndex > haLowIndex

// PART 2 + PART 3: M1 confirmed pivots approximate visual structure. For a bullish CHoCH,
// the last confirmed high must be lower than the preceding confirmed high;
// for a bearish CHoCH the last confirmed low must be higher than the preceding
// confirmed low. No five-bar extreme or generic extreme-at-engulf rule is used.
m1PH = ta.pivothigh(high, M1_Left, M1_Right)
m1PL = ta.pivotlow(low, M1_Left, M1_Right)
lastM1High = ta.valuewhen(not na(m1PH), m1PH, 0)
previousM1High = ta.valuewhen(not na(m1PH), m1PH, 1)
lastM1Low = ta.valuewhen(not na(m1PL), m1PL, 0)
previousM1Low = ta.valuewhen(not na(m1PL), m1PL, 1)
hasLowerHigh = not na(lastM1High) and not na(previousM1High) and lastM1High < previousM1High
hasHigherLow = not na(lastM1Low) and not na(previousM1Low) and lastM1Low > previousM1Low

// The state machine resets outside a confirmed golden session. Open simulated
// positions keep their submitted brackets even when the session ends.
// M5 BOS outside the session is NOT carried into the next session in this draft.
var string state = "NO_SESSION"
var int direction = 0
var int usedHighPivot = na
var int usedLowPivot = na
var float bosLegLow = na
var float bosLegHigh = na
var float prevHigherLow = na
var float newLowerLow = na
var float fib0382 = na
var int bosBar = na
var int reactionBar = na
var int chochBar = na
var float chochLevel = na
var int entryBar = na
bullBos = isGoldenSession and newM5 and validHigh and m5Close > m5SwingHigh and (na(usedHighPivot) or m5HighIndex != usedHighPivot)
bearBos = isGoldenSession and newHaM5 and haBearStructure and haClose < haSwingLow and (na(usedLowPivot) or haLowIndex != usedLowPivot)

// PART 1 / 2 / 3: ordered state machine. One event of each type per M1 bar, used for markers. State updates only on
// confirmed bars. Same-bar reaction/CHoCH/entry are deliberately disallowed:
// OHLC bars do not reveal the intrabar sequence.
bool bullChoch = false
bool bearChoch = false
bool buyEntry = false
bool sellEntry = false
if barstate.isconfirmed
    if not isGoldenSession
        state := "NO_SESSION"
        direction := 0
        bosLegLow := na
        bosLegHigh := na
        prevHigherLow := na
        newLowerLow := na
        fib0382 := na
        chochLevel := na
        bosBar := na
        reactionBar := na
        chochBar := na
    else if strategy.position_size != 0
        state := "ENTRY_SIGNAL"
    else
        if state == "NO_SESSION" or state == "ENTRY_SIGNAL"
            state := "NO_BOS"
        justClosed = strategy.closedtrades > 0 ? strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1) == bar_index : false
        if justClosed
            state := "NO_BOS"
            direction := 0
            fib0382 := na
            chochLevel := na
        else if bullBos or bearBos
            if bullBos
                usedHighPivot := m5HighIndex
            if bearBos
                usedLowPivot := haLowIndex
            direction := bullBos and bearBos ? 0 : bullBos ? 1 : -1
            // Part 1 bull: prior normal-candle M5 swing low to BOS high.
            // Part 3 bear: earlier HA pivot low (higher than broken LL) to the
            // HA low of the BOS candle, the newly created LL. Mapping a visual
            // "previous higher low" to that pivot is an unconfirmed choice.
            prevHigherLow := direction == -1 and validHaPrevLow ? haPrevLow : na
            newLowerLow := direction == -1 ? haLow : na
            bosLegLow := direction == 1 ? (validLow ? m5SwingLow : na) : newLowerLow
            bosLegHigh := direction == 1 ? m5High : prevHigherLow
            anchorsValid = direction != 0 and not na(bosLegLow) and not na(bosLegHigh) and bosLegHigh > bosLegLow
            legRange = anchorsValid ? bosLegHigh - bosLegLow : na
            // Bull: 38.2% DOWN from high. Bear: 38.2% UP from new LL.
            fib0382 := anchorsValid ? (direction == 1 ? bosLegHigh - legRange * 0.382 : newLowerLow + (prevHigherLow - newLowerLow) * 0.382) : na
            state := anchorsValid ? "BOS_FOUND" : "WAITING_ANCHORS"
            bosBar := bar_index
            reactionBar := na
            chochBar := na
            chochLevel := na
        else
            if state == "BOS_FOUND" and bar_index > bosBar
                state := "WAITING_0382"
            // Reaction means the completed M1 candle's range touches the exact
            // candidate level. No tolerance or intrabar ordering is inferred.
            if state == "WAITING_0382" and bar_index > bosBar and low <= fib0382 and high >= fib0382
                state := "WAITING_CHOCH"
                reactionBar := bar_index
            // Break must occur AFTER the reaction candle, confirmed by a close
            // across the then-current confirmed M1 pivot. Bull is VHB, bear VLB.
            if state == "WAITING_CHOCH" and bar_index > reactionBar and direction == 1 and hasLowerHigh and close[1] <= lastM1High and close > lastM1High
                bullChoch := true
                chochLevel := lastM1High
                chochBar := bar_index
                state := "CHOCH_FOUND"
            else if state == "WAITING_CHOCH" and bar_index > reactionBar and direction == -1 and hasHigherLow and close[1] >= lastM1Low and close < lastM1Low
                bearChoch := true
                chochLevel := lastM1Low
                chochBar := bar_index
                state := "CHOCH_FOUND"
            // Part 2/3: full body engulf >1.2x by default. Require the pullback candle AND
            // engulfing candle after the CHoCH bar; require consecutive M1 bars.
            contiguous = not na(time[1]) and time - time[1] == 60000
            bullEngulf = contiguous and close[1] < open[1] and close > open and open <= close[1] and close > open[1] and (close - open) > (open[1] - close[1]) * Engulf_Multiplier
            bearEngulf = contiguous and close[1] > open[1] and close < open and open >= close[1] and close < open[1] and (open - close) > (close[1] - open[1]) * Engulf_Multiplier
            nearFib = not na(fib0382) and math.abs(close - fib0382) <= Fib_Tolerance_Ticks * syminfo.mintick
            canConfirm = state == "CHOCH_FOUND" and bar_index > chochBar + 1 and nearFib and (na(entryBar) or entryBar != bar_index)
            if canConfirm and direction == 1 and bullEngulf
                stop = math.round_to_mintick(low - Stop_Buffer_Ticks * syminfo.mintick)
                risk = close - stop
                target = math.round_to_mintick(close + risk * RR_Ratio)
                if stop > 0 and risk > 0 and target > close
                    buyEntry := true
                    entryBar := bar_index
                    state := "ENTRY_SIGNAL"
                    strategy.entry("Buy", strategy.long, qty=Order_Quantity)
                    strategy.exit("Buy bracket", from_entry="Buy", stop=stop, limit=target)
            else if canConfirm and direction == -1 and bearEngulf
                stop = math.round_to_mintick(high + Stop_Buffer_Ticks * syminfo.mintick)
                risk = stop - close
                target = math.round_to_mintick(close - risk * RR_Ratio)
                if risk > 0 and target > 0 and target < close
                    sellEntry := true
                    entryBar := bar_index
                    state := "ENTRY_SIGNAL"
                    strategy.entry("Sell", strategy.short, qty=Order_Quantity)
                    strategy.exit("Sell bracket", from_entry="Sell", stop=stop, limit=target)

plot(isM1 and isStandard and validHigh ? m5SwingHigh : na, title="Confirmed M5 swing high (provisional pivot)", color=color.new(color.red, 30), style=plot.style_stepline)
plot(isM1 and isStandard and validHaLow ? haSwingLow : na, title="Confirmed M5 HA swing low (provisional pivot)", color=color.new(color.green, 30), style=plot.style_stepline)
plot(isGoldenSession ? fib0382 : na, title="Candidate 0.382 level", color=color.orange, linewidth=3, style=plot.style_linebr)
plot(isGoldenSession ? chochLevel : na, title="CHoCH break level - VHB buy / VLB sell", color=color.aqua, linewidth=2, style=plot.style_linebr)
plotshape(bullChoch, title="Bullish CHoCH VHB candidate", text="VHB?", style=shape.labelup, location=location.belowbar, color=color.teal, textcolor=color.white, size=size.tiny)
plotshape(bearChoch, title="Bearish CHoCH VLB candidate", text="VLB?", style=shape.labeldown, location=location.abovebar, color=color.maroon, textcolor=color.white, size=size.tiny)
plotshape(buyEntry, title="Simulated buy confirmation", text="BUY?", style=shape.triangleup, location=location.belowbar, color=color.lime, textcolor=color.white, size=size.small)
plotshape(sellEntry, title="Simulated sell confirmation", text="SELL?", style=shape.triangledown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
var table panel = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "STRUCTURE DRAFT", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 0, not Enable_Simulation ? "OFF" : not isM1 or not isStandard ? "USE STANDARD M1" : not Sessions_Confirmed ? "CONFIRM SESSIONS" : "SIMULATION ONLY", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 0, 1, "Session", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 1, isGoldenSession ? "GOLDEN" : "NO TRADE", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 0, 2, "State", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 2, state, text_color=color.white, bgcolor=color.black)
    table.cell(panel, 0, 3, "Fib anchor", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 3, direction == -1 ? "BEAR HA: REVIEW" : direction == 1 ? "BULL: DRAFT" : "UNAVAILABLE", text_color=color.white, bgcolor=color.black)
