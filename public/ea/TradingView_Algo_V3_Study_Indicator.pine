//@version=5
indicator("TradingView Algo V3 Study Indicator - Research", shorttitle="Algo V3", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// RESEARCH DRAFT. Unverified interpretation of discretionary rules, not an EA.
// Use STANDARD M1 for entries and virtual positions. M5 HA calculations use
// completed bars. M5 mode is a 0.382 alert monitor only, not an M1 execution view.
// Review the accompanying notes before interpreting historical markers.
left = input.int(2, "Confirmed pivot left bars", minval=1, maxval=20)
right = input.int(2, "Confirmed pivot right bars", minval=1, maxval=20)
setupExpiry = input.int(48, "Maximum M5 bars after 0.382 touch", minval=1, maxval=500)
m1Expiry = input.int(240, "Maximum M1 bars waiting for confirmation", minval=1, maxval=5000)
stopTicks = input.int(10, "Stop buffer (ticks)", minval=0, maxval=1000)
targetR = input.string("3", "Fixed take profit R", options=["2", "3", "4", "5", "7"])
beSetting = input.string("Off", "Breakeven at R", options=["Off", "2", "3"])
exitMode = input.string("Fixed TP + structure", "Exit mode", options=["Fixed TP + structure", "Fixed TP only"])
mode = input.string("Both", "Setup type", options=["Both", "Continuation", "FTB"])
showStudyLevels = input.bool(true, "Show historical entry, stop and R levels")
showBreakLines = input.bool(true, "Show historical M1 CHoCH lines")
showRecap = input.bool(true, "Show hypothetical day/week recap")
studyWidth = input.int(60, "Study level length (bars)", minval=1, maxval=300)
studyDrawCount = input.int(40, "Maximum historical level sets", minval=1, maxval=60)
studySampleCount = input.int(200, "Maximum candidates in recap", minval=10, maxval=500)
scan1 = input.bool(false, "Monitor symbol 1")
symbol1 = input.symbol("OANDA:XAUUSD", "Symbol 1")
scan2 = input.bool(false, "Monitor symbol 2")
symbol2 = input.symbol("OANDA:EURUSD", "Symbol 2")
scan3 = input.bool(false, "Monitor symbol 3")
symbol3 = input.symbol("OANDA:GBPUSD", "Symbol 3")
scan4 = input.bool(false, "Monitor symbol 4")
symbol4 = input.symbol("OANDA:USDJPY", "Symbol 4")
scan5 = input.bool(false, "Monitor symbol 5")
symbol5 = input.symbol("OANDA:GBPJPY", "Symbol 5")
scan6 = input.bool(false, "Monitor symbol 6")
symbol6 = input.symbol("OANDA:AUDUSD", "Symbol 6")
scan7 = input.bool(false, "Monitor symbol 7")
symbol7 = input.symbol("OANDA:USDCAD", "Symbol 7")
scan8 = input.bool(false, "Monitor symbol 8")
symbol8 = input.symbol("OANDA:USDCHF", "Symbol 8")
scan9 = input.bool(false, "Monitor symbol 9")
symbol9 = input.symbol("OANDA:NZDUSD", "Symbol 9")

// This mechanical proxy for "clear" pivots uses confirmed 2-sided HA pivots
// and a close through the prior opposite pivot. It cannot determine visual clarity.
// After an M5 close crosses a prior pivot, the opposite pivot and the breakout
// extreme define an impulse. Its extreme may extend until the first 0.382 touch.
// After that touch the anchors are frozen. FTB requires a later same-direction
// attempt (a higher high / lower low than the preceding HA candle), followed by
// an opposite HA colour close whose wick stays strictly short of the pivot.
// That is an explicit testable approximation, not a verified definition of FTB.
f_m5() =>
    pHigh = ta.pivothigh(high, left, right)
    pLow = ta.pivotlow(low, left, right)
    priorHigh = ta.valuewhen(not na(pHigh), pHigh, 0)
    priorLow = ta.valuewhen(not na(pLow), pLow, 0)
    breakUp = not na(priorHigh) and not na(priorLow) and close > priorHigh and close[1] <= priorHigh
    breakDown = not na(priorHigh) and not na(priorLow) and close < priorLow and close[1] >= priorLow
    var int trend = 0
    var float legHigh = na
    var float legLow = na
    var bool touched = false
    var bool attempted = false
    var int touchedAt = na
    int event = 0
    int touch = 0
    if breakUp and (trend == 0 or (trend == -1 and not touched))
        trend := 1
        legLow := priorLow
        legHigh := high
        touched := false
        attempted := false
    else if breakDown and (trend == 0 or (trend == 1 and not touched))
        trend := -1
        legHigh := priorHigh
        legLow := low
        touched := false
        attempted := false
    else if trend != 0 and not na(legHigh) and not na(legLow) and legHigh > legLow
        if not touched
            // A new extreme and retracement within one OHLC bar have unknown order.
            newExtreme = trend == 1 ? high > legHigh : low < legLow
            if trend == 1
                legHigh := math.max(legHigh, high)
            else
                legLow := math.min(legLow, low)
            fibNow = trend == 1 ? legHigh - (legHigh - legLow) * 0.382 : legLow + (legHigh - legLow) * 0.382
            noPivotTouch = trend == 1 ? high < legHigh : low > legLow
            if not newExtreme and noPivotTouch and low <= fibNow and high >= fibNow
                touched := true
                touchedAt := bar_index
                touch := trend
        else if bar_index > touchedAt
            if bar_index - touchedAt > setupExpiry
                trend := 0
                touched := false
                attempted := false
            else
                bullishBreak = trend == 1 and close > legHigh
                bearishBreak = trend == -1 and close < legLow
                // A failed attempt must not touch the frozen pivot.
                failedHigh = trend == 1 and attempted and high < legHigh and close < open and close[1] > open[1]
                failedLow = trend == -1 and attempted and low > legLow and close > open and close[1] < open[1]
                if bullishBreak or bearishBreak
                    event := trend
                    trend := 0
                    touched := false
                    attempted := false
                else if failedHigh or failedLow
                    event := trend == 1 ? -2 : 2
                    trend := 0
                    touched := false
                    attempted := false
                else if (trend == 1 and high >= legHigh) or (trend == -1 and low <= legLow)
                    // A wick touch disqualifies the no-touch FTB proxy.
                    trend := 0
                    touched := false
                    attempted := false
                else if trend == 1 and close > open and high > high[1] and high < legHigh
                    attempted := true
                else if trend == -1 and close < open and low < low[1] and low > legLow
                    attempted := true
    fibValue = trend == 1 ? legHigh - (legHigh - legLow) * 0.382 : trend == -1 ? legLow + (legHigh - legLow) * 0.382 : na
    upperAnchor = trend != 0 ? legHigh : na
    lowerAnchor = trend != 0 ? legLow : na
    [time[1], fibValue[1], touch[1], event[1], pHigh[1], pLow[1], upperAnchor[1], lowerAnchor[1]]

ha = ticker.heikinashi(syminfo.tickerid)
[ht, fib, touch, event, hp, lp, upper, lower] = request.security(ha, "5", f_m5(), lookahead=barmerge.lookahead_on)
[t1, f1, hit1, e1, ph1, pl1, hi1, lo1] = request.security(ticker.heikinashi(symbol1), "5", f_m5(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[t2, f2, hit2, e2, ph2, pl2, hi2, lo2] = request.security(ticker.heikinashi(symbol2), "5", f_m5(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[t3, f3, hit3, e3, ph3, pl3, hi3, lo3] = request.security(ticker.heikinashi(symbol3), "5", f_m5(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[t4, f4, hit4, e4, ph4, pl4, hi4, lo4] = request.security(ticker.heikinashi(symbol4), "5", f_m5(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[t5, f5, hit5, e5, ph5, pl5, hi5, lo5] = request.security(ticker.heikinashi(symbol5), "5", f_m5(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[t6, f6, hit6, e6, ph6, pl6, hi6, lo6] = request.security(ticker.heikinashi(symbol6), "5", f_m5(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[t7, f7, hit7, e7, ph7, pl7, hi7, lo7] = request.security(ticker.heikinashi(symbol7), "5", f_m5(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[t8, f8, hit8, e8, ph8, pl8, hi8, lo8] = request.security(ticker.heikinashi(symbol8), "5", f_m5(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[t9, f9, hit9, e9, ph9, pl9, hi9, lo9] = request.security(ticker.heikinashi(symbol9), "5", f_m5(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
isM1 = timeframe.isminutes and timeframe.multiplier == 1 and chart.is_standard
isM5 = timeframe.isminutes and timeframe.multiplier == 5 and chart.is_standard
validChart = isM1 or isM5
newM5 = validChart and barstate.isconfirmed and not na(ht) and (na(ht[1]) or ht != ht[1]) and ht + 300000 == time("5")

// Security results are completed M5 bars. On M1 the signal becomes available
// at the close of the first M1 bar in the next M5 period; no lookahead.
if newM5 and touch != 0
    alert("Algo V1 research: 0.382 touched on " + syminfo.tickerid + " (completed M5 HA)", alert.freq_all)
if validChart and barstate.isconfirmed
    if scan1 and hit1 != 0 and not na(t1) and (na(t1[1]) or t1 != t1[1]) and t1 + 300000 == time("5")
        alert("Algo V1 research: 0.382 touched on " + symbol1 + " (completed M5 HA)", alert.freq_all)
    if scan2 and hit2 != 0 and not na(t2) and (na(t2[1]) or t2 != t2[1]) and t2 + 300000 == time("5")
        alert("Algo V1 research: 0.382 touched on " + symbol2 + " (completed M5 HA)", alert.freq_all)
    if scan3 and hit3 != 0 and not na(t3) and (na(t3[1]) or t3 != t3[1]) and t3 + 300000 == time("5")
        alert("Algo V1 research: 0.382 touched on " + symbol3 + " (completed M5 HA)", alert.freq_all)

    if scan4 and hit4 != 0 and not na(t4) and (na(t4[1]) or t4 != t4[1]) and t4 + 300000 == time("5")
        alert("Algo V1 research: 0.382 touched on " + symbol4 + " (completed M5 HA)", alert.freq_all)
    if scan5 and hit5 != 0 and not na(t5) and (na(t5[1]) or t5 != t5[1]) and t5 + 300000 == time("5")
        alert("Algo V1 research: 0.382 touched on " + symbol5 + " (completed M5 HA)", alert.freq_all)
    if scan6 and hit6 != 0 and not na(t6) and (na(t6[1]) or t6 != t6[1]) and t6 + 300000 == time("5")
        alert("Algo V1 research: 0.382 touched on " + symbol6 + " (completed M5 HA)", alert.freq_all)
    if scan7 and hit7 != 0 and not na(t7) and (na(t7[1]) or t7 != t7[1]) and t7 + 300000 == time("5")
        alert("Algo V1 research: 0.382 touched on " + symbol7 + " (completed M5 HA)", alert.freq_all)
    if scan8 and hit8 != 0 and not na(t8) and (na(t8[1]) or t8 != t8[1]) and t8 + 300000 == time("5")
        alert("Algo V1 research: 0.382 touched on " + symbol8 + " (completed M5 HA)", alert.freq_all)
    if scan9 and hit9 != 0 and not na(t9) and (na(t9[1]) or t9 != t9[1]) and t9 + 300000 == time("5")
        alert("Algo V1 research: 0.382 touched on " + symbol9 + " (completed M5 HA)", alert.freq_all)

m1High = ta.pivothigh(high, left, right)
m1Low = ta.pivotlow(low, left, right)
lastHigh = ta.valuewhen(not na(m1High), m1High, 0)
lastLow = ta.valuewhen(not na(m1Low), m1Low, 0)
previousHigh = ta.valuewhen(not na(m1High), m1High, 1)
previousLow = ta.valuewhen(not na(m1Low), m1Low, 1)
lastHighBar = ta.valuewhen(not na(m1High), bar_index - right, 0)
lastLowBar = ta.valuewhen(not na(m1Low), bar_index - right, 0)
bullChoch = not na(previousHigh) and lastHigh < previousHigh and close > lastHigh and close[1] <= lastHigh
bearChoch = not na(previousLow) and lastLow > previousLow and close < lastLow and close[1] >= lastLow
bullEngulf = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bearEngulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]

var int phase = 0
var int direction = 0
var int waitFrom = na
var int tradeDirection = 0
var int entryBar = na
var float entry = na
var float stop = na
var float target = na
var float risk = na
var bool beArmed = false
var float protectedPivot = na
bool buy = false
bool sell = false
bool beMark = false
bool exitStop = false
bool exitTarget = false
bool exitStructure = false
bool chochMark = false
bool gap = not na(time[1]) and time - time[1] != 60000

if isM1 and barstate.isconfirmed
    // Missing candles make intrabar outcomes unknowable. Censor the virtual
    // position and pending setup, rather than inventing a fill over the gap.
    if gap
        phase := 0
        tradeDirection := 0
        entry := na
        stop := na
        target := na
        risk := na
        beArmed := false
        protectedPivot := na
    else
        if tradeDirection != 0 and bar_index > entryBar
            // Only confirmed post-entry higher lows / lower highs can become
            // protected levels; their confirmation delay is not lookahead.
            if exitMode == "Fixed TP + structure"
                if tradeDirection == 1 and not na(m1Low) and not na(previousLow) and lastLow > previousLow and bar_index - right >= entryBar and (na(protectedPivot) or lastLow > protectedPivot)
                    protectedPivot := lastLow
                if tradeDirection == -1 and not na(m1High) and not na(previousHigh) and lastHigh < previousHigh and bar_index - right >= entryBar and (na(protectedPivot) or lastHigh < protectedPivot)
                    protectedPivot := lastHigh
            hitStop = tradeDirection == 1 ? low <= stop : high >= stop
            hitTarget = tradeDirection == 1 ? high >= target : low <= target
            // If both are hit in the same bar, stop first is conservative.
            if hitStop or hitTarget
                exitStop := hitStop
                exitTarget := not hitStop and hitTarget
                tradeDirection := 0
                entry := na
                stop := na
                target := na
                risk := na
                beArmed := false
                protectedPivot := na
            else if exitMode == "Fixed TP + structure" and not na(protectedPivot) and (tradeDirection == 1 ? close < protectedPivot : close > protectedPivot)
                exitStructure := true
                tradeDirection := 0
                entry := na
                stop := na
                target := na
                risk := na
                beArmed := false
                protectedPivot := na
            else if not beArmed and beSetting != "Off" and (tradeDirection == 1 ? high >= entry + risk * str.tonumber(beSetting) : low <= entry - risk * str.tonumber(beSetting))
                // Move stop only after the trigger bar closes; no same-bar BE fill.
                stop := entry
                beArmed := true
                beMark := true
        if phase != 0 and bar_index - waitFrom > m1Expiry
            phase := 0
        retestSelected = touch != 0 and (mode == "Both" or mode == "Continuation")
        ftbSelected = math.abs(event) == 2 and (mode == "Both" or mode == "FTB")
        if newM5 and (retestSelected or ftbSelected) and tradeDirection == 0
            direction := ftbSelected ? (event > 0 ? 1 : -1) : touch
            phase := 1
            waitFrom := bar_index
        else if phase == 1 and bar_index > waitFrom and (direction == 1 ? bullChoch : bearChoch)
            phase := 2
            waitFrom := bar_index
            chochMark := true
        else if phase == 2 and bar_index > waitFrom
            // The engulf must be the immediate next M1 bar after CHoCH.
            if bar_index == waitFrom + 1 and (direction == 1 ? bullEngulf : bearEngulf)
                candidateStop = direction == 1 ? lastLow - stopTicks * syminfo.mintick : lastHigh + stopTicks * syminfo.mintick
                candidateRisk = direction == 1 ? close - candidateStop : candidateStop - close
                if tradeDirection == 0 and not na(candidateStop) and candidateRisk > 0
                    buy := direction == 1
                    sell := direction == -1
                    entry := close
                    stop := candidateStop
                    risk := candidateRisk
                    target := direction == 1 ? close + risk * str.tonumber(targetR) : close - risk * str.tonumber(targetR)
                    tradeDirection := direction
                    entryBar := bar_index
                    beArmed := false
                    protectedPivot := na
            phase := 0

// Bounded historical study: independent hypothetical 2/3/4/5/7R outcomes
// for each selected candidate, not partial fills or native strategy trades.
type StudyTrade
    int when
    int born
    int dir
    float price
    float risk
    int s2
    int s3
    int s4
    int s5
    int s7
    bool b2
    bool b3
    bool b4
    bool b5
    bool b7
    float trailLevel

f_outcome(int state, bool armed, int dir, float price, float r, float multiple, bool missing) =>
    int next = state
    bool nextArmed = armed
    if state == 0
        if missing
            next := -2 // censored at a missing bar
        else
            activeStop = armed ? price : price - dir * r
            targetPrice = price + dir * r * multiple
            stopHit = dir == 1 ? low <= activeStop : high >= activeStop
            targetHit = dir == 1 ? high >= targetPrice : low <= targetPrice
            if stopHit
                next := armed ? 2 : -1
            else if targetHit
                next := 1
            else if not armed and beSetting != "Off" and (dir == 1 ? high >= price + r * str.tonumber(beSetting) : low <= price - r * str.tonumber(beSetting))
                nextArmed := true // effective starting next bar
    [next, nextArmed]

var array<StudyTrade> study = array.new<StudyTrade>()
var array<line> studyLines = array.new_line()
var array<label> studyLabels = array.new_label()
var array<line> breakLines = array.new_line()
var array<box> riskBoxes = array.new_box()

f_studyLevel(float price, string text, color col) =>
    line ln = line.new(bar_index, price, bar_index + studyWidth, price, color=col, style=line.style_dotted)
    label lab = label.new(bar_index + studyWidth, price, text, style=label.style_label_left, size=size.tiny, color=color.new(col, 65), textcolor=color.white)
    array.push(studyLines, ln)
    array.push(studyLabels, lab)
    if array.size(studyLines) > studyDrawCount * 7
        line.delete(array.shift(studyLines))
        label.delete(array.shift(studyLabels))

if isM1 and barstate.isconfirmed
    if array.size(study) > 0
        for i = 0 to array.size(study) - 1
            StudyTrade t = array.get(study, i)
            if bar_index > t.born
                [n2, b2] = f_outcome(t.s2, t.b2, t.dir, t.price, t.risk, 2.0, gap)
                [n3, b3] = f_outcome(t.s3, t.b3, t.dir, t.price, t.risk, 3.0, gap)
                [n4, b4] = f_outcome(t.s4, t.b4, t.dir, t.price, t.risk, 4.0, gap)
                [n5, b5] = f_outcome(t.s5, t.b5, t.dir, t.price, t.risk, 5.0, gap)
                [n7, b7] = f_outcome(t.s7, t.b7, t.dir, t.price, t.risk, 7.0, gap)
                t.s2 := n2
                t.s3 := n3
                t.s4 := n4
                t.s5 := n5
                t.s7 := n7
                t.b2 := b2
                t.b3 := b3
                t.b4 := b4
                t.b5 := b5
                t.b7 := b7
                if exitMode == "Fixed TP + structure"
                    if t.dir == 1 and not na(m1Low) and not na(previousLow) and lastLow > previousLow and bar_index - right >= t.born and (na(t.trailLevel) or lastLow > t.trailLevel)
                        t.trailLevel := lastLow
                    if t.dir == -1 and not na(m1High) and not na(previousHigh) and lastHigh < previousHigh and bar_index - right >= t.born and (na(t.trailLevel) or lastHigh < t.trailLevel)
                        t.trailLevel := lastHigh
                    if not na(t.trailLevel) and (t.dir == 1 ? close < t.trailLevel : close > t.trailLevel)
                        // Stop/target outcomes above take precedence over a close exit.
                        t.s2 := t.s2 == 0 ? 3 : t.s2
                        t.s3 := t.s3 == 0 ? 3 : t.s3
                        t.s4 := t.s4 == 0 ? 3 : t.s4
                        t.s5 := t.s5 == 0 ? 3 : t.s5
                        t.s7 := t.s7 == 0 ? 3 : t.s7
    if buy or sell
        int d = buy ? 1 : -1
        array.push(study, StudyTrade.new(time, bar_index, d, entry, risk, 0, 0, 0, 0, 0, false, false, false, false, false, na))
        if array.size(study) > studySampleCount
            array.shift(study)
        if showStudyLevels
            f_studyLevel(entry, "ENTRY", color.aqua)
            f_studyLevel(stop, "STOP", color.red)
            f_studyLevel(entry + d * risk * 2, "2R", color.yellow)
            f_studyLevel(entry + d * risk * 3, "3R", color.lime)
            f_studyLevel(entry + d * risk * 4, "4R", color.green)
            f_studyLevel(entry + d * risk * 5, "5R", color.blue)
            f_studyLevel(entry + d * risk * 7, "7R", color.purple)
            // Historical visual boxes use the same provisional entry/stop as
            // the study levels; they are not fills or performance evidence.
            box riskBox = box.new(bar_index, math.max(entry, stop), bar_index + studyWidth, math.min(entry, stop), bgcolor=color.new(color.maroon, 78), border_color=color.maroon)
            float fiveR = entry + d * risk * 5
            box rewardBox = box.new(bar_index, math.max(entry, fiveR), bar_index + studyWidth, math.min(entry, fiveR), bgcolor=color.new(color.blue, 82), border_color=color.blue)
            array.push(riskBoxes, riskBox)
            array.push(riskBoxes, rewardBox)
            if array.size(riskBoxes) > studyDrawCount * 2
                box.delete(array.shift(riskBoxes))
                box.delete(array.shift(riskBoxes))
    if showBreakLines and chochMark
        pivotBar = direction == 1 ? lastHighBar : lastLowBar
        pivotPrice = direction == 1 ? lastHigh : lastLow
        if not na(pivotBar) and not na(pivotPrice) and bar_index - pivotBar <= 9999
            line ln = line.new(pivotBar, pivotPrice, bar_index, pivotPrice, color=color.yellow, style=line.style_dashed)
            array.push(breakLines, ln)
            if array.size(breakLines) > 50
                line.delete(array.shift(breakLines))

f_counts(int windowStart, int which) =>
    int hit = 0
    int stopped = 0
    int flat = 0
    int structure = 0
    int openCount = 0
    int censored = 0
    if array.size(study) > 0
        for i = 0 to array.size(study) - 1
            StudyTrade t = array.get(study, i)
            if t.when >= windowStart and t.when <= time
                int result = which == 2 ? t.s2 : which == 3 ? t.s3 : t.s5
                hit += result == 1 ? 1 : 0
                stopped += result == -1 ? 1 : 0
                flat += result == 2 ? 1 : 0
                structure += result == 3 ? 1 : 0
                openCount += result == 0 ? 1 : 0
                censored += result == -2 ? 1 : 0
    [hit, stopped, flat, structure, openCount, censored]

f_tableRow(table panel, int row, string name, int hit, int stopped, int flat, int structure, int openCount, int censored) =>
    int settled = hit + stopped + flat + structure
    string rate = settled > 0 ? str.tostring(100.0 * hit / settled, "#.0") + "%" : "n/a"
    table.cell(panel, 0, row, name, text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, row, str.tostring(hit), text_color=color.lime, text_size=size.tiny)
    table.cell(panel, 2, row, str.tostring(stopped), text_color=color.red, text_size=size.tiny)
    table.cell(panel, 3, row, str.tostring(flat), text_color=color.yellow, text_size=size.tiny)
    table.cell(panel, 4, row, str.tostring(structure), text_color=color.aqua, text_size=size.tiny)
    table.cell(panel, 5, row, str.tostring(openCount) + "/" + str.tostring(censored), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 6, row, rate, text_color=color.white, text_size=size.tiny)

var table recap = table.new(position.bottom_right, 7, 8, border_width=1, bgcolor=color.new(color.black, 20))
if barstate.islast
    table.clear(recap, 0, 0, 6, 7)
    if showRecap and isM1
        // Calendar windows in the symbol's exchange timezone, Monday-start week.
        int localYear = year(time, syminfo.timezone)
        int localMonth = month(time, syminfo.timezone)
        int localDay = dayofmonth(time, syminfo.timezone)
        int dayOffset = (dayofweek(time, syminfo.timezone) + 5) % 7
        int dayStart = timestamp(syminfo.timezone, localYear, localMonth, localDay, 0, 0)
        int weekStart = timestamp(syminfo.timezone, localYear, localMonth, localDay - dayOffset, 0, 0)
        [a2, b2c, c2, structa2, d2, e2c] = f_counts(dayStart, 2)
        [a3, b3c, c3, structa3, d3, e3c] = f_counts(dayStart, 3)
        [a5, b5c, c5, structa5, d5, e5c] = f_counts(dayStart, 5)
        [w2, x2, y2, structw2, z2, q2] = f_counts(weekStart, 2)
        [w3, x3, y3, structw3, z3, q3] = f_counts(weekStart, 3)
        [w5, x5, y5, structw5, z5, q5] = f_counts(weekStart, 5)
        table.cell(recap, 0, 0, "WINDOW / R", text_color=color.white, text_size=size.tiny)
        table.cell(recap, 1, 0, "TP", text_color=color.lime, text_size=size.tiny)
        table.cell(recap, 2, 0, "SL", text_color=color.red, text_size=size.tiny)
        table.cell(recap, 3, 0, "BE", text_color=color.yellow, text_size=size.tiny)
        table.cell(recap, 4, 0, "STRUCT", text_color=color.aqua, text_size=size.tiny)
        table.cell(recap, 5, 0, "OPEN/GAP", text_color=color.white, text_size=size.tiny)
        table.cell(recap, 6, 0, "TP %*", text_color=color.white, text_size=size.tiny)
        f_tableRow(recap, 1, "DAY / 2R", a2, b2c, c2, structa2, d2, e2c)
        f_tableRow(recap, 2, "DAY / 3R", a3, b3c, c3, structa3, d3, e3c)
        f_tableRow(recap, 3, "DAY / 5R", a5, b5c, c5, structa5, d5, e5c)
        f_tableRow(recap, 4, "WEEK / 2R", w2, x2, y2, structw2, z2, q2)
        f_tableRow(recap, 5, "WEEK / 3R", w3, x3, y3, structw3, z3, q3)
        f_tableRow(recap, 6, "WEEK / 5R", w5, x5, y5, structw5, z5, q5)
        table.cell(recap, 0, 7, "*TP/(TP+SL+BE+STRUCT)", text_color=color.gray, text_size=size.tiny)
        table.cell(recap, 3, 7, "LATEST " + str.tostring(studySampleCount) + " MAX", text_color=color.gray, text_size=size.tiny)

plot(validChart ? upper : na, "M5 HA upper anchor", color=color.orange, style=plot.style_linebr)
plot(validChart ? lower : na, "M5 HA lower anchor", color=color.orange, style=plot.style_linebr)
plot(validChart ? fib : na, "M5 HA 0.382", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(isM1 and tradeDirection != 0 ? entry : na, "Virtual entry", color=color.aqua, style=plot.style_linebr)
plot(isM1 and tradeDirection != 0 ? stop : na, "Virtual stop", color=color.red, style=plot.style_linebr)
plot(isM1 and tradeDirection != 0 ? target : na, "Virtual target", color=color.lime, style=plot.style_linebr)
plot(isM1 and tradeDirection != 0 ? protectedPivot : na, "Confirmed structure exit level", color=color.yellow, style=plot.style_linebr)
plotshape(isM1 and not na(m1High), title="M1 confirmed pivot high", style=shape.circle, location=location.abovebar, offset=-right, color=color.new(color.red, 15), size=size.tiny)
plotshape(isM1 and not na(m1Low), title="M1 confirmed pivot low", style=shape.circle, location=location.belowbar, offset=-right, color=color.new(color.lime, 15), size=size.tiny)
plotshape(newM5 and not na(hp), title="M5 HA pivot high confirmed", style=shape.circle, location=location.abovebar, color=color.fuchsia, size=size.tiny)
plotshape(newM5 and not na(lp), title="M5 HA pivot low confirmed", style=shape.circle, location=location.belowbar, color=color.blue, size=size.tiny)
plotshape(newM5 and touch != 0, title="M5 HA 0.382 confirmed", style=shape.circle, location=location.bottom, color=color.orange, size=size.tiny)
plotshape(chochMark, title="M1 CHoCH", style=shape.diamond, location=location.bottom, color=color.aqua, size=size.tiny)
plotshape(buy, title="Virtual buy", style=shape.labelup, location=location.belowbar, text="BUY", color=color.green, textcolor=color.white, size=size.tiny)
plotshape(sell, title="Virtual sell", style=shape.labeldown, location=location.abovebar, text="SELL", color=color.red, textcolor=color.white, size=size.tiny)
plotshape(beMark, title="Breakeven armed after close", style=shape.circle, location=location.bottom, color=color.yellow, size=size.tiny)
plotshape(exitStop, title="Virtual stop", style=shape.xcross, location=location.bottom, color=color.red, size=size.tiny)
plotshape(exitTarget, title="Virtual target", style=shape.xcross, location=location.bottom, color=color.lime, size=size.tiny)
plotshape(exitStructure, title="Virtual structure exit", style=shape.xcross, location=location.bottom, color=color.yellow, size=size.tiny)
alertcondition(buy, "Research buy", "Algo V1 research buy candidate on {{ticker}}. No order placed.")
alertcondition(sell, "Research sell", "Algo V1 research sell candidate on {{ticker}}. No order placed.")
alertcondition(newM5 and touch != 0, "Research 0.382 touch", "Algo V1: completed M5 HA 0.382 touch on {{ticker}}.")

// Last completed M5 HA results, not live/guaranteed readiness. Time freshness
// is checked against the chart's M5 period; missing feeds are never READY.
showScanner = input.bool(true, "Show M5 scanner table")
f_scanRow(table panel, int row, bool enabled, string symbol, int seenTime, float level, int hit) =>
    bool fresh = not na(seenTime) and seenTime + 300000 == time("5")
    string state = not enabled ? "OFF" : na(seenTime) ? "NO DATA" : not fresh ? "STALE" : hit != 0 ? "TOUCH" : na(level) ? "NO SETUP" : "WATCH"
    color c = state == "TOUCH" ? color.orange : state == "WATCH" ? color.aqua : color.gray
    table.cell(panel, 0, row, symbol, text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, row, state, text_color=c, text_size=size.tiny)
    table.cell(panel, 2, row, enabled and fresh and not na(level) ? str.tostring(level, "#.##########") : "—", text_color=color.white, text_size=size.tiny)

var table scanner = table.new(position.bottom_left, 3, 11, border_width=1, bgcolor=color.new(color.black, 20))
if barstate.islast
    table.clear(scanner, 0, 0, 2, 10)
    if showScanner and validChart
        table.cell(scanner, 0, 0, "M5 HA / SYMBOL", text_color=color.white, text_size=size.tiny)
        table.cell(scanner, 1, 0, "STATUS", text_color=color.white, text_size=size.tiny)
        table.cell(scanner, 2, 0, "0.382*", text_color=color.white, text_size=size.tiny)
        f_scanRow(scanner, 1, true, syminfo.tickerid, ht, fib, touch)
        f_scanRow(scanner, 2, scan1, symbol1, t1, f1, hit1)
        f_scanRow(scanner, 3, scan2, symbol2, t2, f2, hit2)
        f_scanRow(scanner, 4, scan3, symbol3, t3, f3, hit3)
        f_scanRow(scanner, 5, scan4, symbol4, t4, f4, hit4)
        f_scanRow(scanner, 6, scan5, symbol5, t5, f5, hit5)
        f_scanRow(scanner, 7, scan6, symbol6, t6, f6, hit6)
        f_scanRow(scanner, 8, scan7, symbol7, t7, f7, hit7)
        f_scanRow(scanner, 9, scan8, symbol8, t8, f8, hit8)
        f_scanRow(scanner, 10, scan9, symbol9, t9, f9, hit9)

// Numeric per-signal series for TradingView's Data Window / chart-data export.
// These are hypothetical levels, not outcomes, a CSV button or broker fills.
plot(isM1 and (buy or sell) ? (buy ? 1 : -1) : na, "Research signal direction (+1/-1)", display=display.data_window)
plot(isM1 and (buy or sell) ? entry : na, "Research signal entry", display=display.data_window)
plot(isM1 and (buy or sell) ? stop : na, "Research signal stop", display=display.data_window)
plot(isM1 and (buy or sell) ? entry + (buy ? 1 : -1) * risk * 2 : na, "Research 2R level", display=display.data_window)
plot(isM1 and (buy or sell) ? entry + (buy ? 1 : -1) * risk * 3 : na, "Research 3R level", display=display.data_window)
plot(isM1 and (buy or sell) ? entry + (buy ? 1 : -1) * risk * 4 : na, "Research 4R level", display=display.data_window)
plot(isM1 and (buy or sell) ? entry + (buy ? 1 : -1) * risk * 5 : na, "Research 5R level", display=display.data_window)
plot(isM1 and (buy or sell) ? entry + (buy ? 1 : -1) * risk * 7 : na, "Research 7R level", display=display.data_window)

var table status = table.new(position.top_right, 1, 2, border_width=1)
if barstate.islast
    table.cell(status, 0, 0, "UNVERIFIED RESEARCH DRAFT", text_color=color.white)
    table.cell(status, 0, 1, isM1 ? "Standard M1: historical candidates + virtual positions" : isM5 ? "Standard M5: 0.382 monitor only" : "Use standard M1 or M5", text_color=validChart ? color.lime : color.red)
