//@version=5
indicator("M5 HA Brain V3 - Tuned to XAU Sep24 - Orange BOS + Yellow CHoCH + Blue Box", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// USER-SUPPLIED REFERENCE: uncompiled, unverified, not for trading.
// Do not treat the title's chart-match claim as verified. See EA Center notes.
// The supplied chochLen=5 and <=3-bar condition cannot both hold for a confirmed pivot.

// === TUNED TO YOUR SCREENSHOTS ===
bosLen = input.int(20, "BOS Lookback for Orange Pivot")
chochLen = input.int(5, "M1 CHoCH Lookback for Yellow")
beAt = input.float(2.0, "BE at 1:")
tp2 = 3.0
tp3 = 4.0
tp4 = 5.0

// === M5 HA BRAIN ===
[haO, haH, haL, haC] = request.security(syminfo.tickerid, "5", [open, high, low, close], gaps=barmerge.gaps_off)
haClose = (haO+haH+haL+haC)/4
var float haOpen = na
haOpen := na(haOpen[1]) ? haO : (haOpen[1]+haClose[1])/2
haColor = haClose > haOpen ? 1 : -1

// === ORANGE LINE = LAST M5 BOS PIVOT ===
phM5 = request.security(syminfo.tickerid, "5", ta.pivothigh(high, 10, 10))
plM5 = request.security(syminfo.tickerid, "5", ta.pivotlow(low, 10, 10))
var float orangePivotHigh = na
var float orangePivotLow = na
isBOSUp = ta.crossover(close, phM5[1])
isBOSDown = ta.crossunder(close, plM5[1])
if isBOSDown and not na(phM5[1])
    orangePivotHigh := phM5[1]
if isBOSUp and not na(plM5[1])
    orangePivotLow := plM5[1]

var line orangeLine = na
if not na(orangePivotHigh)
    line.delete(orangeLine)
    orangeLine := line.new(bar_index-200, orangePivotHigh, bar_index+20, orangePivotHigh, color=color.new(color.orange, 0), width=2, style=line.style_solid)
    label.new(bar_index, orangePivotHigh, "ORANGE BOS PIVOT "+str.tostring(orangePivotHigh), style=label.style_label_left, color=color.orange, textcolor=color.black)

fibRange = math.abs(close - orangePivotHigh)
level382 = orangePivotHigh - fibRange * 0.382

// === YELLOW LINE = M1 CHoCH ===
phM1 = ta.pivothigh(high, chochLen, chochLen)
plM1 = ta.pivotlow(low, chochLen, chochLen)
var float lastLH = na
var float lastHL = na
var int lastLHBar = na
var int lastHLBar = na
if not na(phM1)
    lastLH := phM1
    lastLHBar := bar_index[chochLen]
if not na(plM1)
    lastHL := plM1
    lastHLBar := bar_index[chochLen]
bullCHoCH = ta.crossover(close, lastLH)
bearCHoCH = ta.crossunder(close, lastHL)

var line yellowLine = na
if bearCHoCH
    line.delete(yellowLine)
    yellowLine := line.new(lastHLBar, lastHL, bar_index, lastHL, color=color.new(color.yellow, 0), width=2, style=line.style_dashed)
    label.new(bar_index, lastHL, "YELLOW CHoCH\n"+str.tostring(lastHL), style=label.style_label_left, color=color.yellow, textcolor=color.black)

// === BLUE BOX = ENGULFING ===
bullEng = close > open and close[1] < open[1] and close > open[1]
bearEng = close < open and close[1] > open[1] and close < open[1]
longEntry = bullCHoCH and bullEng and bar_index - lastLHBar <= 3
shortEntry = bearCHoCH and bearEng and bar_index - lastHLBar <= 3

var box blueBox = na
var box riskBox = na
if shortEntry
    entry = close
    sl = orangePivotHigh
    risk = sl - entry
    box.delete(blueBox)
    box.delete(riskBox)
    riskBox := box.new(bar_index, sl, bar_index+100, entry, bgcolor=color.new(color.maroon, 70), border_color=color.maroon)
    blueBox := box.new(bar_index, entry, bar_index+100, entry - risk*tp4, bgcolor=color.new(color.blue, 70), border_color=color.blue)
    label.new(bar_index, entry, "BLUE ENTRY\n"+str.tostring(entry)+"\n1:4/1:5\nHH-> LL/LH", style=label.style_label_up, color=color.blue, textcolor=color.white)
    line.new(bar_index, entry - risk*beAt, bar_index+100, entry - risk*beAt, color=color.yellow, style=line.style_dashed)
    line.new(bar_index, entry - risk*tp2, bar_index+100, entry - risk*tp2, color=color.lime)
    line.new(bar_index, entry - risk*tp4, bar_index+100, entry - risk*tp4, color=color.green, width=2)

plotshape(shortEntry, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL\nEngulf")
plotshape(longEntry, style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BUY\nEngulf")

at0382 = math.abs(close - level382)/close < 0.0015
bgcolor(at0382 ? color.new(color.orange, 85) : na)
alertcondition(at0382, "At 0.382 Orange Fib", "Price at 0.382 from Orange BOS on {{ticker}}")
alertcondition(shortEntry, "Blue Box Sell", "Sell entry like your XAU screenshot on {{ticker}}")
