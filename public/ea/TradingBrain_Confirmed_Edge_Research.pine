//@version=5
indicator("TradingBrain - BT + FTB Confirmed Edge Research", overlay=true, max_labels_count=500)

// Research draft: not compiled in TradingView or validated against the user's
// charts. M5 HA swings and candle colours are synthetic; entries use standard
// M1 OHLC. This indicator displays candidates, not orders or proven results.
// Apply to a standard M1 chart. The single pending setup may be replaced by a
// newer selected event. Signals on gaps are suppressed; positions are not tracked.
//
// Provisional implementation choices to compare with the user's examples:
// 2/2 confirmed pivots by default; prior confirmed HA swings for FTB anchors;
// BT anchors are breakout HA extreme and the opposite preceding HA swing.
// FTB levels expire 200 M5 bars after the pivot; this is a research setting,
// not a verified rule. HA pivot confirmation necessarily introduces lag.

mode = input.string("Both", "Setup mode", options=["Both", "BT only", "FTB only"])
m5Left = input.int(2, "M5 HA pivot left", minval=1, maxval=50)
m5Right = input.int(2, "M5 HA pivot right", minval=1, maxval=50)
m1Left = input.int(2, "M1 pivot left", minval=1, maxval=50)
m1Right = input.int(2, "M1 pivot right", minval=1, maxval=50)
maxAge = input.int(200, "Maximum prior M5 pivot age (research assumption)", minval=2, maxval=2000)
rr = input.float(2.5, "Target reward/risk (research assumption)", minval=0.1, maxval=100)
stopTicks = input.int(10, "Stop buffer ticks (research assumption)", minval=0, maxval=1000)
bodyMultiplier = input.float(1.2, "Minimum engulf body multiple (strictly greater)", minval=1.0, maxval=10)

isM1 = timeframe.isminutes and timeframe.multiplier == 1
usable = isM1 and chart.is_standard

// Request only values completed before the current M5 interval. Values [2]
// for pivots/structure were already available before the event M5 bar opened.
f_m5() =>
    ph = ta.pivothigh(high, m5Left, m5Right)
    pl = ta.pivotlow(low, m5Left, m5Right)
    hi = ta.valuewhen(not na(ph), ph, 0)
    oldHi = ta.valuewhen(not na(ph), ph, 1)
    lo = ta.valuewhen(not na(pl), pl, 0)
    oldLo = ta.valuewhen(not na(pl), pl, 1)
    hiIdx = ta.valuewhen(not na(ph), bar_index - m5Right, 0)
    loIdx = ta.valuewhen(not na(pl), bar_index - m5Right, 0)
    [time[1], bar_index[1], open[1], high[1], low[1], close[1], open[2], close[2], hi[2], oldHi[2], lo[2], oldLo[2], hiIdx[2], loIdx[2]]
haTicker = ticker.heikinashi(syminfo.tickerid)
[ht, hiBar, ho, hh, hl, hc, prevHo, prevHc, swingHigh, previousHigh, swingLow, previousLow, highIdx, lowIdx] = request.security(haTicker, "5", f_m5(), lookahead=barmerge.lookahead_on)
newM5 = usable and barstate.isconfirmed and not na(ht) and (na(ht[1]) or ht != ht[1])
// Never process an old HA event after missing M1/M5 history.
freshM5 = newM5 and ht + 300000 == time("5")
freshHigh = not na(highIdx) and not na(hiBar) and hiBar - highIdx <= maxAge
freshLow = not na(lowIdx) and not na(hiBar) and hiBar - lowIdx <= maxAge
higherStructure = freshHigh and freshLow and not na(previousHigh) and not na(previousLow) and swingHigh > previousHigh and swingLow > previousLow and swingHigh > swingLow
colourFlip = hc > ho and prevHc < prevHo

// The user explicitly selected HH/HL for both directions, and a bullish
// failure candle after a bearish candle for BOTH failure levels. Failed high
// -> sell; failed low -> buy. An actual HA wick touch is mandatory, without
// imposing a maximum penetration or a 30-tick near-miss allowance.
var int usedBtHigh = na
var int usedBtLow = na
var int observedHighIdx = na
var int observedLowIdx = na
var float expectedHigh = na
var float expectedLow = na
// The latest pivot is activated once, then removed by a successful break or
// expiry. A broken level is not silently reactivated on the next candle.
if freshM5
    if not na(highIdx) and (na(observedHighIdx) or highIdx != observedHighIdx)
        observedHighIdx := highIdx
        expectedHigh := swingHigh
    if not na(lowIdx) and (na(observedLowIdx) or lowIdx != observedLowIdx)
        observedLowIdx := lowIdx
        expectedLow := swingLow
    if not freshHigh
        expectedHigh := na
    if not freshLow
        expectedLow := na
btHigh = freshM5 and higherStructure and hc > swingHigh and (na(usedBtHigh) or highIdx != usedBtHigh)
btLow = freshM5 and higherStructure and hc < swingLow and (na(usedBtLow) or lowIdx != usedBtLow)
ftbHigh = freshM5 and higherStructure and colourFlip and not na(expectedHigh) and hh >= expectedHigh and hc < expectedHigh
ftbLow = freshM5 and higherStructure and colourFlip and not na(expectedLow) and hl <= expectedLow and hc > expectedLow
if freshM5
    if not na(expectedHigh) and hc > expectedHigh
        expectedHigh := na
    if not na(expectedLow) and hc < expectedLow
        expectedLow := na
allowBT = mode == "Both" or mode == "BT only"
allowFTB = mode == "Both" or mode == "FTB only"

m1PH = ta.pivothigh(high, m1Left, m1Right)
m1PL = ta.pivotlow(low, m1Left, m1Right)
lastM1High = ta.valuewhen(not na(m1PH), m1PH, 0)
lastM1Low = ta.valuewhen(not na(m1PL), m1PL, 0)
bullCross = not na(lastM1High) and close[1] <= lastM1High and close > lastM1High
bearCross = not na(lastM1Low) and close[1] >= lastM1Low and close < lastM1Low
bullEngulf = close[1] < open[1] and close > open and open <= close[1] and close > open[1] and close - open > (open[1] - close[1]) * bodyMultiplier
bearEngulf = close[1] > open[1] and close < open and open >= close[1] and close < open[1] and open - close > (close[1] - open[1]) * bodyMultiplier

var string state = "WAIT_SETUP"
var string setupType = "NONE"
var int direction = 0
var float fib = na
var int setupBar = na
var int reactionBar = na
var int chochBar = na
var float lastStop = na
var float lastTarget = na
var int btCount = 0
var int ftbCount = 0
var int reactionCount = 0
var int chochCount = 0
var int entryCount = 0
var int ambiguousCount = 0
bool reaction = false
bool choch = false
bool buy = false
bool sell = false
missingM1 = not na(time[1]) and time - time[1] != 60000

if barstate.isconfirmed and usable
    if missingM1
        state := "WAIT_SETUP"
        setupType := "NONE"
        direction := 0
        fib := na
        usedBtHigh := highIdx
        usedBtLow := lowIdx
        expectedHigh := na
        expectedLow := na
        observedHighIdx := highIdx
        observedLowIdx := lowIdx
    else
        selectedBtHigh = allowBT and btHigh
        selectedBtLow = allowBT and btLow
        selectedFtbHigh = allowFTB and ftbHigh
        selectedFtbLow = allowFTB and ftbLow
        eventCount = (selectedBtHigh ? 1 : 0) + (selectedBtLow ? 1 : 0) + (selectedFtbHigh ? 1 : 0) + (selectedFtbLow ? 1 : 0)
        if selectedBtHigh
            usedBtHigh := highIdx
        if selectedBtLow
            usedBtLow := lowIdx
        if eventCount > 1
            ambiguousCount += 1
            state := "WAIT_SETUP"
            setupType := "NONE"
            direction := 0
            fib := na
        else if eventCount == 1
            setupType := selectedBtHigh or selectedBtLow ? "BT" : "FTB"
            direction := selectedBtHigh or selectedFtbLow ? 1 : -1
            // FTB uses the prior confirmed HA low/high. For BT the breakout
            // candle supplies the high (buy) or low (sell); anchors are frozen.
            legLow = selectedBtLow ? hl : swingLow
            legHigh = selectedBtHigh ? hh : swingHigh
            anchorsValid = not na(legLow) and not na(legHigh) and legLow > 0 and legHigh > legLow
            fib := anchorsValid ? (direction == 1 ? legHigh - (legHigh - legLow) * 0.382 : legLow + (legHigh - legLow) * 0.382) : na
            setupBar := bar_index
            reactionBar := na
            chochBar := na
            state := anchorsValid ? "WAIT_FIB" : "WAIT_SETUP"
            if setupType == "BT"
                btCount += 1
            else
                ftbCount += 1
        else if state == "WAIT_FIB" and bar_index > setupBar and low <= fib and high >= fib
            reaction := true
            reactionCount += 1
            reactionBar := bar_index
            state := "WAIT_CHOCH"
        else if state == "WAIT_CHOCH" and bar_index > reactionBar and (direction == 1 ? bullCross : bearCross)
            choch := true
            chochCount += 1
            chochBar := bar_index
            state := "WAIT_ENGULF"
        else if state == "WAIT_ENGULF" and bar_index > chochBar and (direction == 1 ? bullEngulf : bearEngulf)
            candidateStop = direction == 1 ? low - stopTicks * syminfo.mintick : high + stopTicks * syminfo.mintick
            risk = direction == 1 ? close - candidateStop : candidateStop - close
            if candidateStop > 0 and risk > 0
                buy := direction == 1
                sell := direction == -1
                lastStop := candidateStop
                lastTarget := direction == 1 ? close + risk * rr : close - risk * rr
                entryCount += 1
            state := "WAIT_SETUP"
            setupType := "NONE"
            fib := na

plot(usable and state != "WAIT_SETUP" ? fib : na, "Active 0.382", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(usable ? lastStop : na, "Last signal stop", color=color.new(color.red, 30), style=plot.style_linebr)
plot(usable ? lastTarget : na, "Last signal target", color=color.new(color.green, 30), style=plot.style_linebr)
plotshape(reaction, title="0.382 touch", style=shape.circle, location=location.belowbar, color=color.orange, size=size.tiny)
plotshape(choch, title="M1 CHoCH", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.tiny)
plotshape(buy, title="Buy candidate", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white, size=size.tiny)
plotshape(sell, title="Sell candidate", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white, size=size.tiny)
alertcondition(buy, title="Buy candidate", message="TradingBrain research: buy candidate on {{ticker}}. No order was placed.")
alertcondition(sell, title="Sell candidate", message="TradingBrain research: sell candidate on {{ticker}}. No order was placed.")

var table status = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(status, 0, 0, "RESEARCH DRAFT", text_color=color.white)
    table.cell(status, 1, 0, usable ? "M1 standard" : "USE STANDARD M1", text_color=usable ? color.lime : color.red)
    table.cell(status, 0, 1, "Mode / state", text_color=color.white)
    table.cell(status, 1, 1, mode + " / " + state, text_color=color.white)
    table.cell(status, 0, 2, "BT events", text_color=color.white)
    table.cell(status, 1, 2, str.tostring(btCount), text_color=color.white)
    table.cell(status, 0, 3, "FTB events", text_color=color.white)
    table.cell(status, 1, 3, str.tostring(ftbCount), text_color=color.white)
    table.cell(status, 0, 4, "Fib touches", text_color=color.white)
    table.cell(status, 1, 4, str.tostring(reactionCount), text_color=color.white)
    table.cell(status, 0, 5, "CHoCH", text_color=color.white)
    table.cell(status, 1, 5, str.tostring(chochCount), text_color=color.white)
    table.cell(status, 0, 6, "Entry candidates", text_color=color.white)
    table.cell(status, 1, 6, str.tostring(entryCount), text_color=color.white)
    table.cell(status, 0, 7, "Ambiguous events", text_color=color.white)
    table.cell(status, 1, 7, str.tostring(ambiguousCount), text_color=color.white)
