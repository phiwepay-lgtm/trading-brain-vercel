//@version=5
strategy("TradingBrain Strategy - M5+M1 Confluence", overlay=true, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.02, pyramiding=0, calc_on_every_tick=false, calc_on_order_fills=true, max_boxes_count=2)

// SIMULATION ONLY. M5 range/bias and M1 engulf-at-extreme are PR11 proxies,
// NOT proof of M5 structure, BOS/CHoCH, pullback, VLB/VHB or real BT/FTB.
// No actual MT5 bridge is implemented. Never use alerts to place live orders.
Enable_Backtest = input.bool(false, "Enable simulated strategy (OFF by default)")
Enable_Alerts = input.bool(false, "Enable simulated signal JSON alerts (OFF by default)")
Use_M5_Filter = input.bool(true, "Use M5 HTF Filter")
M5_Len = input.int(50, "M5 Swing Lookback", minval=2, maxval=1000)
M1_Len = input.int(5, "M1 Extreme Lookback", minval=1, maxval=100)
Zone_Ticks = input.int(10, "Zone half-width (ticks, visual only)", minval=1, maxval=1000)
Stop_Buffer_Ticks = input.int(10, "Swing stop buffer (ticks)", minval=1, maxval=1000)
RR_Ratio = input.float(2.0, "RR 1:", minval=0.1, maxval=100, step=0.1)
Order_Quantity = input.float(1.0, "Simulated quantity (contracts/units)", minval=0.000001)
Backtest_Start = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Backtest Start Date (UTC)")
Backtest_End = input.time(timestamp("31 Dec 2025 23:59 +0000"), "Backtest End Date (UTC, inclusive bar open)")
Show_Last_500 = input.bool(false, "Show Last 500 Trades Only (dashboard)")
Quarterly_Filter = input.string("ALL", "Quarter (signal bar UTC)", options=["ALL", "Q1", "Q2", "Q3", "Q4"])

// Prior completed M5 only. Deliberately identical to the PR11 indicator.
M5_high = request.security(syminfo.tickerid, "5", ta.highest(high, M5_Len)[1], lookahead=barmerge.lookahead_on)
M5_low = request.security(syminfo.tickerid, "5", ta.lowest(low, M5_Len)[1], lookahead=barmerge.lookahead_on)
M5_close = request.security(syminfo.tickerid, "5", close[1], lookahead=barmerge.lookahead_on)
M5_bar_index = request.security(syminfo.tickerid, "5", bar_index[1], lookahead=barmerge.lookahead_on)
isM1 = timeframe.isminutes and timeframe.multiplier == 1
hasM5 = not na(M5_high) and not na(M5_low) and not na(M5_close) and not na(M5_bar_index) and M5_bar_index >= M5_Len - 1 and M5_high > M5_low
M5_range = M5_high - M5_low
M5_BT_0382 = M5_high - M5_range * 0.382
M5_FTB_0382 = M5_low + M5_range * 0.382
M5_Bias = hasM5 ? (M5_close > M5_BT_0382 ? "BEARISH" : M5_close < M5_FTB_0382 ? "BULLISH" : "NEUTRAL") : "NEUTRAL"
M5_Setup = hasM5 ? (M5_Bias == "BEARISH" ? "BT 0.382 (proxy)" : M5_Bias == "BULLISH" ? "FTB 0.382 (proxy)" : "None") : "Unavailable"
M1_VLB_valid = not Use_M5_Filter or (hasM5 and M5_Bias == "BEARISH")
M1_VHB_valid = not Use_M5_Filter or (hasM5 and M5_Bias == "BULLISH")
recentHigh = ta.highest(high[1], M1_Len)
recentLow = ta.lowest(low[1], M1_Len)
contiguous = not na(time[M1_Len]) and time - time[M1_Len] == M1_Len * 60000
ready = Enable_Backtest and isM1 and barstate.isconfirmed and contiguous and not na(recentHigh) and not na(recentLow)
VLB_detected = ready and close < open and close[1] > open[1] and open >= close[1] and close <= open[1] and high >= recentHigh
VHB_detected = ready and close > open and close[1] < open[1] and open <= close[1] and close >= open[1] and low <= recentLow
VLB_valid = VLB_detected and M1_VLB_valid
VHB_valid = VHB_detected and M1_VHB_valid
inDateRange = Backtest_Start <= Backtest_End and time >= Backtest_Start and time <= Backtest_End
entryMonth = month(time, "UTC")
entryQuarter = entryMonth <= 3 ? "Q1" : entryMonth <= 6 ? "Q2" : entryMonth <= 9 ? "Q3" : "Q4"
inQuarter = Quarterly_Filter == "ALL" or Quarterly_Filter == entryQuarter

// Fixed bracket based on signal close and that candle's extreme + buffer.
// Default market fill occurs on the next available tick, so gaps/slippage can
// change actual R or cross a bracket. This is NOT a guarantee of RR_Ratio.
sellStop = math.round_to_mintick(math.max(high, recentHigh) + Stop_Buffer_Ticks * syminfo.mintick)
buyStop = math.round_to_mintick(math.min(low, recentLow) - Stop_Buffer_Ticks * syminfo.mintick)
sellRisk = sellStop - close
buyRisk = close - buyStop
sellTP = math.round_to_mintick(close - sellRisk * RR_Ratio)
buyTP = math.round_to_mintick(close + buyRisk * RR_Ratio)
// Avoid immediate re-entry on fill-recalculation of a bar where an exit occurred.
justClosed = strategy.closedtrades > 0 ? strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1) == bar_index : false
varip int lastEntryBar = na
canEnter = inDateRange and inQuarter and strategy.position_size == 0 and not justClosed and (na(lastEntryBar) or lastEntryBar != bar_index)
sellSignal = VLB_valid and canEnter and sellRisk > 0 and sellTP > 0 and sellTP < close
buySignal = VHB_valid and canEnter and buyRisk > 0 and buyStop > 0 and buyTP > close
plotshape(sellSignal, title="VLB sell candidate", text="VLB?", style=shape.triangledown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)
plotshape(buySignal, title="VHB buy candidate", text="VHB?", style=shape.triangleup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)

// alertcondition() has no effect for strategies. The actual opt-in strategy
// alert is alert() below; create an alert for "alert() function calls only".
// Messages are simulation candidates, not MT5 orders, and fire in realtime only.
alertcondition(sellSignal and Enable_Alerts, title="TV->MT5 SELL", message='{"action":"SELL","symbol":"{{ticker}}","price":"{{close}}","setup":"VLB_proxy","source":"TradingBrain_PR12"}')
alertcondition(buySignal and Enable_Alerts, title="TV->MT5 BUY", message='{"action":"BUY","symbol":"{{ticker}}","price":"{{close}}","setup":"VHB_proxy","source":"TradingBrain_PR12"}')
escapeJson(string value) => str.replace_all(str.replace_all(value, "\\", "\\\\"), "\"", "\\\"")
alertJson(string action, string setup) => '{"action":"' + action + '","symbol":"' + escapeJson(syminfo.tickerid) + '","price":' + str.tostring(close, format.mintick) + ',"bias":"' + M5_Bias + '","setup":"' + setup + '","source":"TradingBrain_PR12","mode":"SIMULATION_ONLY","m5_filter":' + (Use_M5_Filter ? 'true' : 'false') + ',"signal_bar_open_ms":' + str.tostring(time) + '}'
if sellSignal
    lastEntryBar := bar_index
    strategy.entry("VLB Sell", strategy.short, qty=Order_Quantity, comment=str.tostring(sellStop, format.mintick))
    strategy.exit("VLB TP/SL", from_entry="VLB Sell", stop=sellStop, limit=sellTP)
    if Enable_Alerts
        alert(alertJson("SELL", Use_M5_Filter ? "VLB_M5_BT_proxy" : "VLB_unfiltered_proxy"), alert.freq_once_per_bar_close)
if buySignal
    lastEntryBar := bar_index
    strategy.entry("VHB Buy", strategy.long, qty=Order_Quantity, comment=str.tostring(buyStop, format.mintick))
    strategy.exit("VHB TP/SL", from_entry="VHB Buy", stop=buyStop, limit=buyTP)
    if Enable_Alerts
        alert(alertJson("BUY", Use_M5_Filter ? "VHB_M5_FTB_proxy" : "VHB_unfiltered_proxy"), alert.freq_once_per_bar_close)
// TODO PR13: a secure external relay and MT5 receiver are NOT included.

var box btBox = na
var box ftbBox = na
if barstate.islast
    if Enable_Backtest and isM1 and hasM5
        left = math.max(0, bar_index - math.min(M5_Len * 5, 9999))
        pad = syminfo.mintick * Zone_Ticks
        if na(btBox)
            btBox := box.new(left, M5_BT_0382 + pad, bar_index, M5_BT_0382 - pad, bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 40))
            ftbBox := box.new(left, M5_FTB_0382 + pad, bar_index, M5_FTB_0382 - pad, bgcolor=color.new(color.green, 80), border_color=color.new(color.green, 40))
        else
            box.set_lefttop(btBox, left, M5_BT_0382 + pad)
            box.set_rightbottom(btBox, bar_index, M5_BT_0382 - pad)
            box.set_lefttop(ftbBox, left, M5_FTB_0382 + pad)
            box.set_rightbottom(ftbBox, bar_index, M5_FTB_0382 - pad)
    else
        if not na(btBox)
            box.delete(btBox)
            box.delete(ftbBox)
            btBox := na
            ftbBox := na

// Closed-trade metrics: PL is strategy.closedtrades.profit as reported by TV;
// DD is peak-to-trough of closed-trade PL only, excludes open/intrabar DD.
// R uses gross price movement divided by abs(actual fill - saved stop); excludes
// commission/costs. Invalid gap-through-stop trades are omitted from Avg R.
// Quarters are based on EXIT time in UTC, across years. Entry filter uses signal
// bar UTC quarter; trades can exit outside their entry quarter/date range.
varip int processed = 0
varip int allWins = 0
varip float allGain = 0.0
varip float allLoss = 0.0
varip float allEquity = 0.0
varip float allPeak = 0.0
varip float allDD = 0.0
varip float allR = 0.0
varip int allRN = 0
varip array<float> allQGain = array.new_float(4, 0.0)
varip array<float> allQLoss = array.new_float(4, 0.0)
varip array<float> recentPL = array.new_float()
varip array<float> recentR = array.new_float()
varip array<int> recentQ = array.new_int()
if strategy.closedtrades > processed
    for i = processed to strategy.closedtrades - 1
        pl = strategy.closedtrades.profit(i)
        entry = strategy.closedtrades.entry_price(i)
        exit = strategy.closedtrades.exit_price(i)
        stop = str.tonumber(strategy.closedtrades.entry_comment(i))
        isSell = strategy.closedtrades.entry_id(i) == "VLB Sell"
        validRisk = not na(stop) and (isSell ? stop > entry : stop < entry)
        r = validRisk ? (isSell ? entry - exit : exit - entry) / math.abs(entry - stop) : na
        exitMonth = month(strategy.closedtrades.exit_time(i), "UTC")
        q = int(math.floor((exitMonth - 1) / 3))
        allWins += pl > 0 ? 1 : 0
        allGain += math.max(pl, 0)
        allLoss += math.max(-pl, 0)
        allEquity += pl
        allPeak := math.max(allPeak, allEquity)
        allDD := math.max(allDD, allPeak - allEquity)
        if not na(r)
            allR += r
            allRN += 1
        array.set(allQGain, q, array.get(allQGain, q) + math.max(pl, 0))
        array.set(allQLoss, q, array.get(allQLoss, q) + math.max(-pl, 0))
        array.push(recentPL, pl)
        array.push(recentR, r)
        array.push(recentQ, q)
        if array.size(recentPL) > 500
            array.shift(recentPL)
            array.shift(recentR)
            array.shift(recentQ)
    processed := strategy.closedtrades

pf(float gains, float losses) => losses > 0 ? str.tostring(gains / losses, "#.##") : "—"
var table panel = table.new(position.top_right, 2, 6, border_width=1)
var table stats = table.new(position.bottom_left, 2, 12, border_width=1)
if barstate.islast
    active = Enable_Backtest and isM1
    biasText = not active ? "DISABLED / USE M1" : not hasM5 ? "UNAVAILABLE" : M5_Bias
    biasColor = not active or not hasM5 or M5_Bias == "NEUTRAL" ? color.gray : M5_Bias == "BULLISH" ? color.green : color.red
    levelText = not active or not hasM5 or M5_Bias == "NEUTRAL" ? "—" : str.tostring(M5_Bias == "BEARISH" ? M5_BT_0382 : M5_FTB_0382, format.mintick)
    confluence = not active ? "OFF / USE M1" : not Use_M5_Filter ? "FILTER OFF" : not hasM5 ? "NO - M5 unavailable" : VLB_valid or VHB_valid ? "YES" : VLB_detected or VHB_detected ? "NO - waiting M5" : "NO - waiting M1"
    table.cell(panel, 0, 0, "M5 Bias", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 0, biasText, text_color=color.white, bgcolor=biasColor)
    table.cell(panel, 0, 1, "M5 Setup", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 1, active ? M5_Setup : "Disabled", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 0, 2, "M5 Level", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 2, levelText, text_color=color.white, bgcolor=color.black)
    table.cell(panel, 0, 3, "M1 Signal", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 3, sellSignal ? "VLB Sell?" : buySignal ? "VHB Buy?" : "HOLD", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 0, 4, "Confluence", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 4, confluence, text_color=color.white, bgcolor=color.black)
    table.cell(panel, 0, 5, "Status", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, 5, "Simulation only", text_color=color.white, bgcolor=color.black)

    n = Show_Last_500 ? array.size(recentPL) : strategy.closedtrades
    wins = allWins
    gain = allGain
    loss = allLoss
    dd = allDD
    rSum = allR
    rN = allRN
    qG = array.copy(allQGain)
    qL = array.copy(allQLoss)
    if Show_Last_500
        wins := 0
        gain := 0.0
        loss := 0.0
        dd := 0.0
        rSum := 0.0
        rN := 0
        eq = 0.0
        peak = 0.0
        qG := array.new_float(4, 0.0)
        qL := array.new_float(4, 0.0)
        if n > 0
            for i = 0 to n - 1
                p = array.get(recentPL, i)
                r = array.get(recentR, i)
                q = array.get(recentQ, i)
                wins += p > 0 ? 1 : 0
                gain += math.max(p, 0)
                loss += math.max(-p, 0)
                eq += p
                peak := math.max(peak, eq)
                dd := math.max(dd, peak - eq)
                if not na(r)
                    rSum += r
                    rN += 1
                array.set(qG, q, array.get(qG, q) + math.max(p, 0))
                array.set(qL, q, array.get(qL, q) + math.max(-p, 0))
    table.cell(stats, 0, 0, "SIMULATION / UTC", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 1, 0, Show_Last_500 ? "Last 500 (custom)" : "All closed (custom)", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 0, 1, "Closed trades (all)", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 1, 1, str.tostring(strategy.closedtrades), text_color=color.white, bgcolor=color.black)
    table.cell(stats, 0, 2, "Trades in view", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 1, 2, str.tostring(n), text_color=color.white, bgcolor=color.black)
    table.cell(stats, 0, 3, "Win rate (view)", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 1, 3, n > 0 ? str.tostring(100.0 * wins / n, "#.##") + "%" : "—", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 0, 4, "Profit factor", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 1, 4, pf(gain, loss), text_color=color.white, bgcolor=color.black)
    table.cell(stats, 0, 5, "Max DD (closed only)", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 1, 5, n > 0 ? str.tostring(dd, "#.##") : "—", text_color=color.white, bgcolor=color.black, tooltip="Peak-to-trough closed-trade P/L only, not Strategy Tester intrabar max drawdown.")
    table.cell(stats, 0, 6, "Avg gross price R", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 1, 6, rN > 0 ? str.tostring(rSum / rN, "#.##") + " (" + str.tostring(rN) + "/" + str.tostring(n) + ")" : "—", text_color=color.white, bgcolor=color.black, tooltip="Price-based R from actual fill to saved stop, before commissions; gap-through-stop trades excluded.")
    table.cell(stats, 0, 7, "Quarter PF (exit UTC)", text_color=color.white, bgcolor=color.black)
    table.cell(stats, 1, 7, "Across years", text_color=color.white, bgcolor=color.black)
    for q = 0 to 3
        table.cell(stats, 0, q + 8, "Q" + str.tostring(q + 1), text_color=color.white, bgcolor=color.black)
        table.cell(stats, 1, q + 8, pf(array.get(qG, q), array.get(qL, q)), text_color=color.white, bgcolor=color.black)
