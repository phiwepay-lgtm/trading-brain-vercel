//@version=6
// Trading Brain — All In One (for a Basic plan: keep one saved script).
// Combines four original TradingView Pine studies into a single indicator:
//   1. Dark Orders Pure Price + History  (Blackwatch)
//   2. Trend Predictor anchor            (Zeiierman, CC BY-NC-SA 4.0)
//   3. My Session Range — developing high/low (Blackwatch Advisory / RobMinty FXN)
//   4. NQ Developing Volume Profile      (chart-bar approximation)
// Each component has its own input group and can be switched off so you only
// run what you need. This script has NOT been compiled or verified in TradingView.
// On a Basic plan keep heavy parts disabled to stay within the 20-second limit.
indicator("Trading Brain — All In One [Dark Orders + Anchor + Session + NQ]", shorttitle="All In 1", overlay=true, max_bars_back=2000, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================== 1. DARK ORDERS ==============================
gD = "Dark Orders"
showDark = input.bool(true, "Show Dark Orders", group=gD, tooltip="Price-only range/body expansion with Heikin Ashi confirmation, a recap table and alerts.")
len = input.int(50, "Prevailing Lookback (what is normal)", minval=1, group=gD)
rangeMult = input.float(1.8, "Range Expansion (1.8x = unusual)", group=gD)
bodyMult = input.float(1.8, "Body Expansion", group=gD)
showTable = input.bool(true, "Show History Recap Table", group=gD)
tableLookback = input.int(20, "Number of recent signals in table", minval=1, maxval=100, group=gD)

barRange = high - low
body = math.abs(close - open)
prevRange = ta.sma(barRange, len)
prevBody = ta.sma(body, len)
rangeStd = ta.stdev(barRange, len)
bodyStd = ta.stdev(body, len)

rangeRvol = prevRange > 0 ? barRange / prevRange : 1.0
rangeZ = rangeStd > 0 ? (barRange - prevRange) / rangeStd : 0.0
bodyRvol = prevBody > 0 ? body / prevBody : 1.0
bodyZ = bodyStd > 0 ? (body - prevBody) / bodyStd : 0.0

isRangeUnusual = rangeRvol >= rangeMult and rangeZ >= 1.5
isBodyUnusual = bodyRvol >= bodyMult and bodyZ >= 1.5

// The Heikin Ashi body is calculated on the current chart timeframe.
haT = ticker.heikinashi(syminfo.tickerid)
[haO, haC] = request.security(haT, timeframe.period, [open, close])
haBody = math.abs(haC - haO)
haBodyAvg = ta.sma(haBody, 20)
haExpanding = haBody > haBodyAvg * 1.2

isUnusual = isRangeUnusual and isBodyUnusual
darkBull = isUnusual and haExpanding and close > open
darkBear = isUnusual and haExpanding and close < open

bullCol = color.new(#00E5FF, 10)
bearCol = color.new(#FF3D57, 10)
warnCol = color.new(color.orange, 30)
barcolor(showDark ? (darkBull ? bullCol : darkBear ? bearCol : isUnusual ? warnCol : na) : na, title="Pure Price Paint")

plotshape(showDark and darkBull, "DARK+ Pure", style=shape.labelup, text="DARK+ PURE", location=location.belowbar, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(showDark and darkBear, "DARK- Pure", style=shape.labeldown, text="DARK- PURE", location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)

// Alerts must be at the top level, not inside an if block.
alertcondition(showDark and darkBull, "Dark Bull History", "DARK+ Pure printed")
alertcondition(showDark and darkBear, "Dark Bear History", "DARK- Pure printed")

// Record confirmed directional signals across the loaded chart history.
var int bullCount = 0
var int bearCount = 0
var signalTimes = array.new_int(0)
var signalDirections = array.new_int(0)
var signalPrices = array.new_float(0)

if barstate.isconfirmed and (darkBull or darkBear)
    if darkBull
        bullCount += 1
    else
        bearCount += 1
    array.unshift(signalTimes, time)
    array.unshift(signalDirections, darkBull ? 1 : -1)
    array.unshift(signalPrices, close)
    if array.size(signalTimes) > tableLookback
        array.pop(signalTimes)
        array.pop(signalDirections)
        array.pop(signalPrices)

var table recap = table.new(position.top_right, 3, tableLookback + 2, bgcolor=color.new(color.black, 20), border_width=1)
if showDark and barstate.islast
    table.clear(recap, 0, 0, 2, tableLookback + 1)
    if showTable
        table.cell(recap, 0, 0, "BAR TIME*", text_color=color.white, text_size=size.tiny)
        table.cell(recap, 1, 0, "TYPE / TF", text_color=color.white, text_size=size.tiny)
        table.cell(recap, 2, 0, "CLOSE", text_color=color.white, text_size=size.tiny)
        int stored = array.size(signalTimes)
        if stored > 0
            for i = 0 to stored - 1
                int direction = array.get(signalDirections, i)
                string typeStr = (direction == 1 ? "DARK+ " : "DARK- ") + timeframe.period
                color signalColor = direction == 1 ? color.lime : color.red
                table.cell(recap, 0, i + 1, str.format_time(array.get(signalTimes, i), "yyyy-MM-dd HH:mm", syminfo.timezone), text_color=color.white, text_size=size.tiny)
                table.cell(recap, 1, i + 1, typeStr, text_color=signalColor, text_size=size.tiny)
                table.cell(recap, 2, i + 1, str.tostring(array.get(signalPrices, i), format.mintick), text_color=color.white, text_size=size.tiny)
        // Counts cover all loaded bars, not just the displayed rows.
        table.cell(recap, 0, tableLookback + 1, "LOADED: " + str.tostring(bullCount + bearCount), text_color=color.yellow, text_size=size.tiny)
        table.cell(recap, 1, tableLookback + 1, "BULL: " + str.tostring(bullCount), text_color=color.lime, text_size=size.tiny)
        table.cell(recap, 2, tableLookback + 1, "BEAR: " + str.tostring(bearCount), text_color=color.red, text_size=size.tiny)

// * Times are bar-open times in the symbol's exchange timezone.

// ====================== 2. TREND PREDICTOR ANCHOR (Zeiierman) ======================
// Adapted from Rolling Candle Profile with Buy/Sell Signals by Zeiierman.
// Original (c) Zeiierman, CC BY-NC-SA 4.0: https://creativecommons.org/licenses/by-nc-sa/4.0/
// Changes: anchor-only, VWAP/volume-weighted EMA blend and closed-candle display.
// Dark Orders and the anchor are independent; neither is a filter for the other.
gA = "Anchor"
gV = "Appearance"
anchType = input.string("VWAP + Volume-weighted EMA", "Anchor", options=["VWAP + Volume-weighted EMA", "EMA", "SMA", "VWMA", "VWAP", "Donchian Mid"], group=gA, tooltip="The default is an equal blend of VWAP and EMA(close × volume) / EMA(volume). It needs usable chart volume. VWMA and VWAP fall back to EMA if unavailable. Donchian Mid uses the preceding completed window.")
anchorLen = input.int(21, "Length", minval=5, maxval=200, group=gA, tooltip="Lookback for the volume-weighted EMA, EMA, SMA, VWMA and Donchian Mid. VWAP uses the chart's VWAP calculation instead.")
buyCol = input.color(#00EFB4, "Rising anchor", group=gV)
sellCol = input.color(#FF3D6E, "Falling anchor", group=gV)
anchOn = input.bool(true, "Show anchor", group=gV)
glowOn = input.bool(true, "Show anchor glow", group=gV)

// Compute each time series on every bar. Selecting an input restarts the script.
baseEma = ta.ema(close, anchorLen)
baseSma = ta.sma(close, anchorLen)
baseVwma = ta.vwma(close, anchorLen)
baseVwap = ta.vwap(hlc3)
// Zero or unavailable volume contributes no weight, and the blend is hidden
// for a bar with no usable volume instead of silently substituting another line.
validVolume = not na(volume) and volume > 0
volumeWeight = validVolume ? volume : 0.0
weightedCloseEma = ta.ema(close * volumeWeight, anchorLen)
volumeEma = ta.ema(volumeWeight, anchorLen)
volumeWeightedEma = validVolume and volumeEma > 0 ? weightedCloseEma / volumeEma : na
blendedAnchor = validVolume and not na(baseVwap) and not na(volumeWeightedEma) ? (baseVwap + volumeWeightedEma) * 0.5 : na
baseDonchian = (ta.highest(high, anchorLen)[1] + ta.lowest(low, anchorLen)[1]) * 0.5
anchor = switch anchType
    "VWAP + Volume-weighted EMA" => blendedAnchor
    "SMA" => baseSma
    "VWMA" => na(baseVwma) ? baseEma : baseVwma
    "VWAP" => na(baseVwap) ? baseEma : baseVwap
    "Donchian Mid" => baseDonchian
    => baseEma

// No developing-bar value is drawn. Values become visible on candle close.
anchorCol = anchor >= nz(anchor[1], anchor) ? buyCol : sellCol
confirmedAnchor = anchOn and barstate.isconfirmed ? anchor : na
plot(glowOn ? confirmedAnchor : na, "Anchor Glow", color=color.new(anchorCol, 50), linewidth=6, style=plot.style_linebr)
plot(confirmedAnchor, "Anchor", color=anchorCol, linewidth=2, style=plot.style_linebr)

// ============================ 3. MY SESSION RANGE ============================
// Based on the user-supplied Blackwatch Advisory - My Session Range, itself a
// modification of RobMinty's FXN - Asian Session Range. Explicit timezone
// replaces the source's hard-coded broker offset. Developing steps and optional
// fill for every observed session in loaded data. Uses the chart's high/low:
// on Heikin Ashi these are synthetic, not real prices.
gS = "My Session Range"
showSession = input.bool(true, "Show session", group=gS, tooltip="Developing high/low steps for the selected session.")
sessionHours = input.session("1500-1900", "Session time", group=gS, tooltip="Your active window, e.g. 15:00–19:00 (3pm–7pm) in the selected timezone. Overnight sessions are supported. The fixed-range VP has its own independent time inputs.")
sessionZone = input.string("UTC+2", "Session timezone", group=gS, tooltip="UTC+2 matches your 1pm NQ open / 3pm–7pm session. Use America/New_York to follow Eastern daylight saving time.")
showFill = input.bool(true, "Shade between high and low", group="Range Style")
edgeColor = input.color(color.teal, "Range line color", group="Range Style")
edgeWidth = input.int(1, "Range line width", minval=1, maxval=10, group="Range Style")
fillColor = input.color(color.new(color.aqua, 90), "Range shading color", group="Range Style")

startHour = int(str.tonumber(str.substring(sessionHours, 0, 2)))
startMinute = int(str.tonumber(str.substring(sessionHours, 2, 4)))
endHour = int(str.tonumber(str.substring(sessionHours, 5, 7)))
endMinute = int(str.tonumber(str.substring(sessionHours, 7, 9)))
startOfDay = startHour * 60 + startMinute
endOfDay = endHour * 60 + endMinute
crossesMidnight = endOfDay <= startOfDay
validChart = timeframe.isintraday and timeframe.in_seconds() <= 3600
inSession = validChart and not na(time(timeframe.period, sessionHours + ":1234567", sessionZone))

// Derive a unique session start using the selected local calendar; the
// previous local day is used for the after-midnight half of overnight sessions.
localMinutes = hour(time, sessionZone) * 60 + minute(time, sessionZone)
startDay = dayofmonth(time, sessionZone) - (crossesMidnight and localMinutes < endOfDay ? 1 : 0)
startTime = timestamp(sessionZone, year(time, sessionZone), month(time, sessionZone), startDay, startHour, startMinute)
var int trackedStart = na
var float sessionHigh = na
var float sessionLow = na
bool newSession = false
if inSession
    newSession := na(trackedStart) or startTime != trackedStart
    if newSession
        trackedStart := startTime
        sessionHigh := high
        sessionLow := low
    else
        sessionHigh := math.max(sessionHigh, high)
        sessionLow := math.min(sessionLow, low)

// Avoid joining sessions if no out-of-session candle exists between them.
bool breakPlot = newSession and inSession[1]
bool visible = showSession and inSession and not breakPlot
// Both the values and colors are na outside the session to prevent step lines
// from bridging gaps. fillgaps=false keeps the shading within the session.
upper = plot(visible ? sessionHigh : na, "Developing session high", color=visible ? edgeColor : na, linewidth=edgeWidth, style=plot.style_stepline)
lower = plot(visible ? sessionLow : na, "Developing session low", color=visible ? edgeColor : na, linewidth=edgeWidth, style=plot.style_stepline)
fill(upper, lower, color=visible and showFill ? fillColor : na, title="Session range shading", fillgaps=false)

// ====================== 4. NQ DEVELOPING VOLUME PROFILE ======================
// Independent chart-bar approximation, not TradingView's proprietary SVP HD.
// Latest 16:00-to-16:00 America/New_York window only; normal intraday candles
// recommended. Uniform volume over each candle's high-low range; directional
// volume is candle direction, NOT aggressor buy/sell. Zero-volume/missing bars,
// gaps and incomplete history affect output.
gN = "NQ Volume Profile"
showNQ = input.bool(true, "Show NQ profile (16:00 NY)", group=gN, tooltip="Latest 16:00-to-16:00 America/New_York window. Approximate, chart-bar volume; not SVP HD.")
rows = input.int(40, "Price rows", minval=10, maxval=100, group=gN)
maxBars = input.int(1500, "Maximum bars to scan", minval=10, maxval=1800, group=gN, tooltip="If the limit is reached, the profile can be incomplete. 1500 supports about 24 hours of 1-minute bars.")
areaPercent = input.float(70.0, "Value area %", minval=1, maxval=100, step=1, group=gN)
mode = input.string("Total", "Volume display", options=["Total", "Up/Down", "Delta"], group=gN)
widthPct = input.float(30.0, "Maximum histogram width (% of observed range)", minval=5, maxval=100, group=gN)
const string TZ = "America/New_York"

// timestamp() normalizes the previous calendar day, including year and DST transitions.
f_anchor(int t) =>
    int y = year(t, TZ)
    int m = month(t, TZ)
    int d = dayofmonth(t, TZ)
    int dayOffset = hour(t, TZ) >= 16 ? 0 : -1
    timestamp(TZ, y, m, d + dayOffset, 16, 0)

var array<box> boxes = array.new<box>()
var array<line> lines = array.new<line>()
var table status = table.new(position.bottom_right, 1, 1)
if showNQ and barstate.islast
    while array.size(boxes) > 0
        box.delete(array.pop(boxes))
    while array.size(lines) > 0
        line.delete(array.pop(lines))
    if not timeframe.isintraday or timeframe.in_seconds() < 60 or timeframe.in_seconds() > 3600
        table.cell(status, 0, 0, "Use standard intraday candles, 1m–1h", text_color=color.white, bgcolor=color.red)
    else
        int sessAnchor = f_anchor(time)
        int found = 0
        float hi = na
        float lo = na
        bool missingVolume = false
        int available = math.min(maxBars, bar_index + 1)
        for i = 0 to available - 1
            if f_anchor(time[i]) != sessAnchor
                break
            found += 1
            hi := na(hi) ? high[i] : math.max(hi, high[i])
            lo := na(lo) ? low[i] : math.min(lo, low[i])
            missingVolume := missingVolume or na(volume[i])
        bool truncated = found == maxBars and bar_index + 1 > maxBars and f_anchor(time[maxBars]) == sessAnchor
        bool historyStart = found == bar_index + 1
        float span = hi - lo
        array<float> ups = array.new_float(rows, 0.0)
        array<float> downs = array.new_float(rows, 0.0)
        float total = 0.0
        if found > 0 and span > 0
            float step = span / rows
            for i = 0 to found - 1
                float v = nz(volume[i], 0)
                if v > 0
                    float candleSpan = high[i] - low[i]
                    bool up = close[i] >= open[i]
                    if candleSpan <= 0
                        int b = math.max(0, math.min(rows - 1, int(math.floor((close[i] - lo) / step))))
                        if up
                            array.set(ups, b, array.get(ups, b) + v)
                        else
                            array.set(downs, b, array.get(downs, b) + v)
                    else
                        int first = math.max(0, math.min(rows - 1, int(math.floor((low[i] - lo) / step))))
                        int last = math.max(0, math.min(rows - 1, int(math.floor((high[i] - lo) / step))))
                        for j = first to last
                            float overlap = math.max(0.0, math.min(high[i], lo + (j + 1) * step) - math.max(low[i], lo + j * step))
                            float portion = v * overlap / candleSpan
                            if up
                                array.set(ups, j, array.get(ups, j) + portion)
                            else
                                array.set(downs, j, array.get(downs, j) + portion)
                    total += v
            if total > 0
                int poc = 0
                float maxTotal = -1.0
                float maxDisplay = 0.0
                for j = 0 to rows - 1
                    float u = array.get(ups, j)
                    float d = array.get(downs, j)
                    float rowTotal = u + d
                    if rowTotal > maxTotal
                        maxTotal := rowTotal
                        poc := j
                    maxDisplay := math.max(maxDisplay, mode == "Delta" ? math.abs(u - d) : rowTotal)
                int val = poc
                int vah = poc
                float included = maxTotal
                float target = total * areaPercent / 100.0
                // Adjacent row with greater volume; ties nearest POC, then above.
                for iteration = 0 to rows - 1
                    if included >= target or (val == 0 and vah == rows - 1)
                        break
                    float below = val > 0 ? array.get(ups, val - 1) + array.get(downs, val - 1) : -1.0
                    float above = vah < rows - 1 ? array.get(ups, vah + 1) + array.get(downs, vah + 1) : -1.0
                    bool chooseAbove = above > below or (above == below and vah + 1 - poc <= poc - (val - 1))
                    float candidate = chooseAbove ? above : below
                    if candidate < 0 or included + candidate > target
                        break
                    included += candidate
                    if chooseAbove
                        vah += 1
                    else
                        val -= 1
                int start = bar_index - found + 1
                int maxWidth = math.max(1, math.min(400, int(math.round(math.max(1, found - 1) * widthPct / 100))))
                for j = 0 to rows - 1
                    float u = array.get(ups, j)
                    float d = array.get(downs, j)
                    float displayVol = mode == "Delta" ? math.abs(u - d) : u + d
                    if displayVol > 0 and maxDisplay > 0
                        int width = math.max(1, int(math.round(maxWidth * displayVol / maxDisplay)))
                        float bottom = lo + step * j
                        float top = lo + step * (j + 1)
                        bool inVA = j >= val and j <= vah
                        color base = inVA ? color.new(color.blue, 30) : color.new(color.gray, 55)
                        if mode == "Up/Down"
                            int upWidth = int(math.round(width * u / (u + d)))
                            if upWidth > 0
                                array.push(boxes, box.new(start, top, start + upWidth, bottom, border_color=na, bgcolor=inVA ? color.new(color.teal, 25) : color.new(color.teal, 65)))
                            if width > upWidth
                                array.push(boxes, box.new(start + upWidth, top, start + width, bottom, border_color=na, bgcolor=inVA ? color.new(color.red, 25) : color.new(color.red, 65)))
                        else
                            color c = mode == "Delta" ? (u >= d ? color.new(color.teal, inVA ? 25 : 65) : color.new(color.red, inVA ? 25 : 65)) : base
                            array.push(boxes, box.new(start, top, start + width, bottom, border_color=na, bgcolor=c))
                array.push(lines, line.new(start, lo + (poc + 0.5) * step, bar_index, lo + (poc + 0.5) * step, color=color.yellow, width=2))
                array.push(lines, line.new(start, lo + (vah + 1) * step, bar_index, lo + (vah + 1) * step, color=color.aqua))
                array.push(lines, line.new(start, lo + val * step, bar_index, lo + val * step, color=color.aqua))
                table.cell(status, 0, 0, "NQ profile • " + str.tostring(found) + " bars" + (truncated ? " • SCAN LIMIT" : "") + (missingVolume ? " • MISSING VOLUME" : "") + (historyStart ? " • HISTORY START" : "") + "\n16:00 NY → now • chart-bar estimate", text_color=color.white, bgcolor=color.new(color.black, 25))
            else
                table.cell(status, 0, 0, "No positive volume in range", text_color=color.white, bgcolor=color.red)
        else
            table.cell(status, 0, 0, "NQ 16:00 NY window not in loaded history — scroll back to include 16:00 NY", text_color=color.white, bgcolor=color.red)

// ============================ 5. VVWAP (daily reset) ============================
// Volume-Weighted Average Price that resets at the start of each day.
gW = "VVWAP"
showVVWAP = input.bool(true, "Show VVWAP (daily)", group=gW, tooltip="Volume-Weighted Average Price resetting at the start of each day. Hidden when the instrument has no usable volume.")
var float _cumPV = 0.0
var float _cumV = 0.0
bool newDay = barstate.isfirst or dayofmonth(time) != dayofmonth(time[1])
if newDay
    _cumPV := 0.0
    _cumV := 0.0
_cumPV := _cumPV + hlc3 * volume
_cumV := _cumV + volume
float vvwap = _cumV > 0 ? _cumPV / _cumV : na
plot(showVVWAP ? vvwap : na, "VVWAP (daily)", color=color.yellow, linewidth=2)

// ====================== 6. SESSION VOLUME PROFILE (fixed range) ======================
// Body/wick allocation adapted from Volume Profile / Fixed Range by
// © LonesomeTheBlue, Mozilla Public License 2.0: https://mozilla.org/MPL/2.0/
// Modified: independent recurring time window, presets, guarded zero ranges.
// Chart-bar approximation, not aggressor buy/sell or TradingView SVP HD.
gF = "Session VP"
showFRVP = input.bool(true, "Show session VP (fixed range)", group=gF)
frTimePreset = input.string("Custom", "Time preset", options=["Custom", "11:00–19:00", "15:00–19:00", "09:00–17:00"], group=gF)
frCustomHours = input.session("1500-1900", "Custom start / stop time", group=gF)
frZone = input.string("UTC+2", "Profile timezone", group=gF, tooltip="All presets use this timezone. Use America/New_York for automatic Eastern DST.")
frHours = frTimePreset == "11:00–19:00" ? "1100-1900" : frTimePreset == "15:00–19:00" ? "1500-1900" : frTimePreset == "09:00–17:00" ? "0900-1700" : frCustomHours
frHistory = input.int(3, "Sessions to display (including latest)", minval=1, maxval=5, group=gF, tooltip="Completed profiles stay on their original session. Only sessions inside the scan limit are available. Rows are capped to share the drawing budget with NQ.")
frScan = input.int(1800, "History bars to scan", minval=100, maxval=1800, group=gF, tooltip="Includes gaps between sessions. On 1-minute charts this may cover only one session; use a higher timeframe for multi-day recap.")
frRows = input.int(24, "Row size", minval=5, maxval=100, group=gF)
frArea = input.float(70, "Value area volume %", minval=0, maxval=100, group=gF)
frWidth = input.float(33.33, "Profile width %", minval=5, maxval=100, group=gF)
frColors = input.string("Original blue / orange", "Colour preset", options=["Original blue / orange", "Teal / red", "Custom"], group=gF)
frCustomVAUp = input.color(color.new(color.blue, 30), "Custom value area up", group=gF)
frCustomVADown = input.color(color.new(color.orange, 30), "Custom value area down", group=gF)
frCustomUp = input.color(color.new(color.blue, 75), "Custom up volume", group=gF)
frCustomDown = input.color(color.new(color.orange, 75), "Custom down volume", group=gF)
frVAUp = frColors == "Custom" ? frCustomVAUp : color.new(frColors == "Teal / red" ? color.teal : color.blue, 30)
frVADown = frColors == "Custom" ? frCustomVADown : color.new(frColors == "Teal / red" ? color.red : color.orange, 30)
frUp = frColors == "Custom" ? frCustomUp : color.new(frColors == "Teal / red" ? color.teal : color.blue, 75)
frDown = frColors == "Custom" ? frCustomDown : color.new(frColors == "Teal / red" ? color.red : color.orange, 75)
frPOCColor = input.color(color.red, "POC colour", group=gF)
frPOCWidth = input.int(2, "POC width", minval=1, maxval=5, group=gF)
frShowPOC = input.bool(true, "Show POC label", group=gF)
frExtendPOC = input.bool(true, "Extend POC right", group=gF)
frSH = int(str.tonumber(str.substring(frHours, 0, 2)))
frSM = int(str.tonumber(str.substring(frHours, 2, 4)))
frEH = int(str.tonumber(str.substring(frHours, 5, 7)))
frEM = int(str.tonumber(str.substring(frHours, 7, 9)))
frOvernight = frEH * 60 + frEM <= frSH * 60 + frSM
frMinutes = hour(time, frZone) * 60 + minute(time, frZone)
frDay = dayofmonth(time, frZone) - (frOvernight and frMinutes < frEH * 60 + frEM ? 1 : 0)
frStart = timestamp(frZone, year(time, frZone), month(time, frZone), frDay, frSH, frSM)
// Bar OPEN must be within [start, stop). Align boundaries to the chart timeframe.
frInSession = validChart and not na(time(timeframe.period, frHours + ":1234567", frZone))
var int frTrackedStart = na
if frInSession
    frTrackedStart := frStart

frOverlap(float bottom, float top, float segBottom, float segTop, float vol) =>
    float height = segTop - segBottom
    height > 0 ? math.max(0.0, math.min(top, segTop) - math.max(bottom, segBottom)) * vol / height : 0.0

var array<box> frBoxes = array.new<box>()
var array<line> frLines = array.new<line>()
var array<int> frIdx = array.new_int(0)
var array<label> frLabels = array.new<label>()
var array<int> frSessions = array.new_int()
var table frStatus = table.new(position.bottom_left, 1, 1)
if showFRVP and barstate.islast
    while array.size(frLabels) > 0
        label.delete(array.pop(frLabels))
    array.clear(frSessions)
    array.clear(frIdx)
    while array.size(frBoxes) > 0
        box.delete(array.pop(frBoxes))
    while array.size(frLines) > 0
        line.delete(array.pop(frLines))
    if not timeframe.isintraday or timeframe.in_seconds() < 60 or timeframe.in_seconds() > 3600
        table.cell(frStatus, 0, 0, "Use standard intraday candles, 1m–1h", text_color=color.white, bgcolor=color.red)
    else
        // Discover only sessions with an actual in-window candle: no future profile.
        int available = math.min(frScan, bar_index + 1)
        for i = 0 to available - 1
            if frInSession[i]
                int anchor = frStart[i]
                if array.size(frSessions) == 0
                    array.push(frSessions, anchor)
                else if anchor != array.get(frSessions, array.size(frSessions) - 1)
                    if array.size(frSessions) >= frHistory
                        break
                    array.push(frSessions, anchor)
        // Reserve 200 boxes for NQ and at most 300 for session profiles.
        int frDrawRows = math.min(frRows, int(math.floor(150.0 / frHistory)))
        if array.size(frSessions) == 0
            table.cell(frStatus, 0, 0, "Session VP: waiting for configured start / no session in scan history", text_color=color.white, bgcolor=color.new(color.black, 25))
        else
            for sessionNumber = 0 to array.size(frSessions) - 1
                int winStart = array.get(frSessions, sessionNumber)
                array.clear(frIdx)
                int found = 0
                float hi = na
                float lo = na
                bool missingVolume = false
                for i = 0 to available - 1
                    // Only bars that belong to the most recent session (same start time).
                    if frStart[i] == winStart and frInSession[i]
                        array.push(frIdx, i)
                        found += 1
                        hi := na(hi) ? high[i] : math.max(hi, high[i])
                        lo := na(lo) ? low[i] : math.min(lo, low[i])
                        missingVolume := missingVolume or na(volume[i])
                    else if time[i] < winStart
                        break
                bool truncated = available == frScan and bar_index + 1 > frScan and time[available - 1] > winStart
                bool historyStart = bar_index + 1 <= frScan and found > 0 and time[available - 1] > winStart
                if found > 0 and hi == lo
                    hi += syminfo.mintick / 2
                    lo -= syminfo.mintick / 2
                float span = hi - lo
                array<float> ups = array.new_float(frDrawRows, 0.0)
                array<float> downs = array.new_float(frDrawRows, 0.0)
                float total = 0.0
                if found > 0 and span > 0
                    float step = span / frDrawRows
                    for k = 0 to array.size(frIdx) - 1
                        int i = array.get(frIdx, k)
                        float v = nz(volume[i], 0)
                        if v > 0
                            float bodyTop = math.max(open[i], close[i])
                            float bodyBot = math.min(open[i], close[i])
                            float body = bodyTop - bodyBot
                            float topWick = high[i] - bodyTop
                            float bottomWick = bodyBot - low[i]
                            float weight = body + 2 * topWick + 2 * bottomWick
                            bool green = close[i] >= open[i]
                            if weight <= 0
                                int bucket = math.max(0, math.min(frDrawRows - 1, int(math.floor((close[i] - lo) / step))))
                                array.set(ups, bucket, array.get(ups, bucket) + v)
                            else
                                for j = 0 to frDrawRows - 1
                                    float bottom = lo + j * step
                                    float top = bottom + step
                                    float bodyPart = frOverlap(bottom, top, bodyBot, bodyTop, body * v / weight)
                                    float wickPart = (frOverlap(bottom, top, bodyTop, high[i], 2 * topWick * v / weight) + frOverlap(bottom, top, low[i], bodyBot, 2 * bottomWick * v / weight)) / 2
                                    array.set(ups, j, array.get(ups, j) + wickPart + (green ? bodyPart : 0))
                                    array.set(downs, j, array.get(downs, j) + wickPart + (green ? 0 : bodyPart))
                            total += v
                    if total > 0
                        int poc = 0
                        float maxTotal = -1.0
                        float maxDisplay = 0.0
                        for j = 0 to frDrawRows - 1
                            float u = array.get(ups, j)
                            float dd = array.get(downs, j)
                            float rowTotal = u + dd
                            if rowTotal > maxTotal
                                maxTotal := rowTotal
                                poc := j
                            maxDisplay := math.max(maxDisplay, rowTotal)
                        int val = poc
                        int vah = poc
                        float included = maxTotal
                        float target = total * frArea / 100.0
                        for iteration = 0 to frDrawRows - 1
                            if included >= target or (val == 0 and vah == frDrawRows - 1)
                                break
                            float below = val > 0 ? array.get(ups, val - 1) + array.get(downs, val - 1) : -1.0
                            float above = vah < frDrawRows - 1 ? array.get(ups, vah + 1) + array.get(downs, vah + 1) : -1.0
                            bool chooseAbove = above >= below
                            float candidate = chooseAbove ? above : below
                            if candidate < 0
                                break
                            included += candidate
                            if chooseAbove
                                vah += 1
                            else
                                val -= 1
                        int startBar = bar_index - array.get(frIdx, array.size(frIdx) - 1)
                        int endBar = bar_index - array.get(frIdx, 0)
                        int maxWidth = math.max(1, math.min(400, int(math.round(math.max(1, array.size(frIdx) - 1) * frWidth / 100))))
                        for j = 0 to frDrawRows - 1
                            float u = array.get(ups, j)
                            float dd = array.get(downs, j)
                            float displayVol = u + dd
                            if displayVol > 0 and maxDisplay > 0
                                int width = math.max(1, int(math.round(maxWidth * displayVol / maxDisplay)))
                                float bottom = lo + step * j
                                float top = lo + step * (j + 1)
                                bool inVA = j >= val and j <= vah
                                float gap = span / 500
                                int upWidth = int(math.round(width * u / (u + dd)))
                                if upWidth > 0
                                    array.push(frBoxes, box.new(startBar, top - gap, startBar + upWidth, bottom + gap, border_width=0, bgcolor=inVA ? frVAUp : frUp))
                                if width > upWidth
                                    array.push(frBoxes, box.new(startBar + upWidth, top - gap, startBar + width, bottom + gap, border_width=0, bgcolor=inVA ? frVADown : frDown))
                        array.push(frLines, line.new(startBar, lo + (poc + 0.5) * step, endBar, lo + (poc + 0.5) * step, color=frPOCColor, width=frPOCWidth, extend=frExtendPOC and sessionNumber == 0 ? extend.right : extend.none))
                        array.push(frLines, line.new(startBar, lo + (vah + 1) * step, endBar, lo + (vah + 1) * step, color=color.aqua))
                        array.push(frLines, line.new(startBar, lo + val * step, endBar, lo + val * step, color=color.aqua))
                        if frShowPOC
                            float pocPrice = lo + (poc + 0.5) * step
                            array.push(frLabels, label.new(endBar + 15, pocPrice, "POC: " + str.tostring(pocPrice, format.mintick), style=label.style_label_left, color=frPOCColor, textcolor=color.white))
                        if sessionNumber == 0
                            table.cell(frStatus, 0, 0, (frInSession and sessionNumber == 0 ? "Session VP developing • " : "Session VP frozen • ") + str.tostring(found) + " bars" + (truncated ? " • SCAN LIMIT" : "") + (missingVolume ? " • MISSING VOLUME" : "") + (historyStart ? " • HISTORY START" : "") + "\n" + frHours + " " + frZone + " • chart-bar estimate", text_color=color.white, bgcolor=color.new(color.black, 25))
                    else
                        if sessionNumber == 0
                            table.cell(frStatus, 0, 0, "No positive volume in range", text_color=color.white, bgcolor=color.red)
                else
                    if sessionNumber == 0
                        table.cell(frStatus, 0, 0, "Session VP: no session bars in loaded history — ensure the chart covers your session window", text_color=color.white, bgcolor=color.red)
